#!/bin/sh
# Stand-in for `docker run [options] IMAGE command...`, so backend/scripts/baseline-load.sh runs unmodified inside the container that already
# is that image: it runs the command here, exports each -e value, and makes each -v source appear at its container path.
[ "$1" = run ] && shift
# shellcheck disable=SC2163  # `export "$2"` where $2 is a NAME=value string assigns and exports that variable
while [ $# -gt 0 ]; do
  case "$1" in
    --rm|-i|-t|-it) shift ;;
    --add-host|--network) shift 2 ;;
    -e) export "$2"; shift 2 ;;
    # a mount whose source and destination are already the same folder (compared by real path) needs nothing; otherwise link it (this needs write access to /)
    -v) src="${2%%:*}"; rest="${2#*:}"; dst="${rest%%:*}"; real_src="$(cd -P "$src" 2>/dev/null && pwd)"; real_dst="$(cd -P "$dst" 2>/dev/null && pwd)"
        [ -n "$real_src" ] && [ "$real_src" = "$real_dst" ] || ln -sfn "$src" "$dst"; shift 2 ;;
    -*) shift ;;
    *) shift; break ;;
  esac
done
exec "$@"
