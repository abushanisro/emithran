# eMithran local development settings TEMPLATE. Copy to .env (cp .env.example .env) and fill in the REPLACE_ME values.
# .env is the ONE env file for every local process (Next.js, backend, cad-engine, ecad-engine, tests).
# Git-ignored. Deployed environments use env/stage.env and env/prd.env instead (env/README.md).
# NODE_ENV is never set here: each tool sets it itself (next dev, nest start, jest).

# ==========================================================================
# Which environment this is
# ==========================================================================
# local | stage | prd. The e2e suites and the migration runner refuse prd.
APP_ENV=local

# ==========================================================================
# Data: Postgres behind PostgREST. Locally `npm run local:up` / `local:load` / `local:use` (in backend/) start both in Docker and
# fill these in.
# ==========================================================================
POSTGREST_URL=http://127.0.0.1:3001
DB_JWT_SECRET=REPLACE_ME       # openssl rand -hex 32; the same value as PostgREST's PGRST_JWT_SECRET. Never sent to the browser.

# ==========================================================================
# Service addresses and shared secrets
# ==========================================================================
NEXT_PUBLIC_API_URL=http://localhost:4000/v1/api
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Browser API calls always go through the Next.js server (/api/v1), which attaches the session's token.
# API address the Next.js server uses (for example the Docker network name); falls back to NEXT_PUBLIC_API_URL.
# API_URL=http://backend:4000/v1/api
NEXT_PUBLIC_APP_VERSION=1.0.0-dev
NEXT_PUBLIC_CAD_ENGINE_URL="http://localhost:5055"
CAD_ENGINE_URL=http://localhost:5055
ECAD_ENGINE_URL=http://127.0.0.1:5100
# Shared secret between the backend, Next.js server and cad-engine (openssl rand -hex 32).
CAD_ENGINE_API_KEY=REPLACE_ME
# Shared secret between the backend and ecad-engine.
ECAD_ENGINE_API_KEY=REPLACE_ME

# ==========================================================================
# Ports (one name per service: a shared PORT cannot serve three processes)
# ==========================================================================
BACKEND_PORT=4000
CAD_ENGINE_PORT=5055
ECAD_ENGINE_PORT=5100

# ==========================================================================
# Backend
# ==========================================================================
CORS_ORIGIN=http://localhost:3000
# Lets requests act as a mock user without a login (ignored when NODE_ENV=production). Off by default; set true only on your own machine, never
# outside local development.
ALLOW_DEV_AUTH_BYPASS=false
# Only used when ALLOW_DEV_AUTH_BYPASS=true.
ADMIN_FALLBACK_EMAIL=dev@example.com
SKIP_ENV_VALIDATION=false
# table (the job_queue table, migration 920) | memory (local, jobs lost on restart)
ELECTRONICS_QUEUE_DRIVER=memory
LOG_LEVEL=debug
# The one upload limit in MB (backend, engine and upload card).
MAX_UPLOAD_MB=50
# Parse and connection limits (backend/src/common/resource-limits.ts; defaults shown, an invalid value stops the backend at boot).
# ARCHIVE_MAX_EXPANDED_MB=256        # what a CAD or electronics .zip may expand to
# XLSX_MAX_ENTRY_MB=20               # largest part of an uploaded workbook
# XLSX_MAX_MEDIA_ENTRY_MB=5          # largest picture (xl/media/*) in a workbook
# XLSX_MAX_EXPANDED_MB=50            # what a workbook may expand to
# HEAVY_WORK_MAX_CONCURRENT=2        # workbook/archive parses at once per backend process (503 + Retry-After beyond)
# HEAVY_WORK_MAX_PER_TENANT=1        # per organization, or per user without one (429 + Retry-After beyond)
# HEAVY_WORK_WORKER_HEAP_MB=256      # heap of the worker thread a parse runs in (413 when exceeded)
# HEAVY_WORK_TIMEOUT_MS=60000
# HTTP_REQUEST_TIMEOUT_MS=300000     # HTTP_HEADERS_TIMEOUT_MS=20000  HTTP_KEEP_ALIVE_TIMEOUT_MS=5000  HTTP_MAX_HEADERS_COUNT=100
# ORG_THROTTLE_LIMIT=3000            # requests per ORG_THROTTLE_TTL ms (60000) for one organization, all users and routes
# Client address behind the BFF (backend/src/common/client-ip.ts). Required in production on both the frontend and the backend.
# BFF_FORWARD_SECRET=                # openssl rand -hex 32
# TRUST_PROXY=0                      # X-Forwarded-For hops (or proxy subnets) to trust; never "true"
# python | rust (docs/ASSEMBLY_CORE.md)
CAD_CORE=python
# python | rust (the Rust nester; falls back to python if unavailable)
NESTING_ENGINE=python

# ==========================================================================
# cad-engine (Python). Tuning values; every one has a default in cad-engine/shared/config.py
# ==========================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
LINEAR_DEFLECTION=0.1
ANGULAR_DEFLECTION=0.5
RATE_LIMIT_PER_MINUTE=10
TEMP_DIR=/tmp/cad_engine
BYPASS_CAD_FORMAT_CHECK=false

# ==========================================================================
# AI
# ==========================================================================
# One key for every consumer (Next.js routes, backend, cad-engine).
ANTHROPIC_API_KEY=

# ==========================================================================
# End-to-end tests (backend/test/*.e2e-spec.ts, e2e/): two test accounts in two organizations. Stage only.
# ==========================================================================
E2E_EMAIL=qa-a@example.com
E2E_PASSWORD=REPLACE_ME
E2E_EMAIL_B=qa-b@example.com
E2E_PASSWORD_B=REPLACE_ME


# Auth0: the only sign-in. Check a tenant with `npm run auth0:check` (in backend/).
# Backend
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.emithran.com
AUTH0_CLAIM_NAMESPACE=https://emithran.com/
# Web app (Regular Web Application in Auth0; callback http://localhost:3000/auth/callback, logout URL http://localhost:3000)
AUTH0_CLIENT_ID=REPLACE_ME
AUTH0_CLIENT_SECRET=REPLACE_ME
AUTH0_SECRET=REPLACE_ME      # openssl rand -hex 32
APP_BASE_URL=http://localhost:3000
# "Sign in with SSO" uses this Auth0 enterprise connection (company Google Workspace, Microsoft Entra ID, SAML). Unset = no SSO button;
# there is no fallback to a public social login. Build time.
# NEXT_PUBLIC_AUTH0_SSO_CONNECTION=emithran-auth

# Files in an S3-compatible bucket (AWS S3, Cloudflare R2; locally SeaweedFS from `npm run local:up`). The download host must also be
# named in TRUSTED_STORAGE_HOSTS so the file proxy and the browser's 3D viewer may fetch from it.
TRUSTED_STORAGE_HOSTS=127.0.0.1
S3_BUCKET=emithran
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:8333
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=testtesttest
