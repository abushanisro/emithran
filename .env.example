# eMithran local development settings TEMPLATE. Copy to .env (cp .env.example .env) and fill in the REPLACE_ME values.
# .env is the ONE env file for every local process (Next.js, backend, cad-engine, ecad-engine, tests).
# Git-ignored. Deployed environments use env/stage.env and env/prd.env instead (env/README.md).
# NODE_ENV is never set here: each tool sets it itself (next dev, nest start, jest).

# ==========================================================================
# Which environment this is
# ==========================================================================
# local | stage | prd. The e2e suites and the migration runner refuse prd.
APP_ENV=local

# ==========================================================================
# Supabase: the stage project (shared QA database). Local development runs against stage.
# ==========================================================================
# Browser + Next.js server. The URL and the publishable key are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://mhhyilxeoxzlbiytwdcm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Backend and Next.js server routes.
SUPABASE_URL=https://mhhyilxeoxzlbiytwdcm.supabase.co
# The same publishable key (the backend keeps the legacy name).
SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
# SECRET (sb_secret_...): dashboard -> Project Settings -> API Keys. Server only; never a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_KEY=sb_secret_REPLACE_ME

# Data backend (leaving Supabase, CLAUDE.md "Leaving Supabase"). Default `supabase`: the settings above are used. With `postgrest` the backend
# talks to a PostgREST in front of plain Postgres and signs its own tokens; the three SUPABASE_* backend values are then not needed.
# DB_BACKEND=postgrest
# POSTGREST_URL=http://localhost:3001
# DB_JWT_SECRET=REPLACE_ME       # openssl rand -hex 32; the same value as PostgREST's PGRST_JWT_SECRET. Never sent to the browser.

# ==========================================================================
# Service addresses and shared secrets
# ==========================================================================
NEXT_PUBLIC_API_URL=http://localhost:4000/v1/api
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=1.0.0-dev
NEXT_PUBLIC_CAD_ENGINE_URL="http://localhost:5055"
CAD_ENGINE_URL=http://localhost:5055
ECAD_ENGINE_URL=http://127.0.0.1:5100
# Shared secret between the backend, Next.js server and cad-engine (openssl rand -hex 32).
CAD_ENGINE_API_KEY=REPLACE_ME
# Shared secret between the backend and ecad-engine.
ECAD_ENGINE_API_KEY=REPLACE_ME

# ==========================================================================
# Ports (one name per service: a shared PORT cannot serve three processes)
# ==========================================================================
BACKEND_PORT=4000
CAD_ENGINE_PORT=5055
ECAD_ENGINE_PORT=5100

# ==========================================================================
# Backend
# ==========================================================================
CORS_ORIGIN=http://localhost:3000
# Never true outside local development.
ALLOW_DEV_AUTH_BYPASS=true
# Only used when ALLOW_DEV_AUTH_BYPASS=true.
ADMIN_FALLBACK_EMAIL=dev@example.com
DISABLE_AUTH=true
NEXT_PUBLIC_DISABLE_AUTH=false
SKIP_ENV_VALIDATION=false
# table (the job_queue table, migration 920) | memory (local, jobs lost on restart)
ELECTRONICS_QUEUE_DRIVER=memory
LOG_LEVEL=debug
# The one upload limit (backend, engine and upload card). 50 = Supabase free-tier object cap.
MAX_UPLOAD_MB=50
# python | rust (docs/ASSEMBLY_CORE.md)
CAD_CORE=python
# python | rust (the Rust nester; falls back to python if unavailable)
NESTING_ENGINE=python

# ==========================================================================
# cad-engine (Python). Tuning values; every one has a default in cad-engine/shared/config.py
# ==========================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
LINEAR_DEFLECTION=0.1
ANGULAR_DEFLECTION=0.5
RATE_LIMIT_PER_MINUTE=10
TEMP_DIR=/tmp/cad_engine
BYPASS_CAD_FORMAT_CHECK=false

# ==========================================================================
# AI
# ==========================================================================
# One key for every consumer (Next.js routes, backend, cad-engine).
ANTHROPIC_API_KEY=

# ==========================================================================
# End-to-end tests (backend/test/*.e2e-spec.ts, e2e/): two test accounts in two organizations. Stage only.
# ==========================================================================
E2E_EMAIL=qa-a@example.com
E2E_PASSWORD=REPLACE_ME
E2E_EMAIL_B=qa-b@example.com
E2E_PASSWORD_B=REPLACE_ME


# Auth0 (only with AUTH_BACKEND=auth0, which also needs DB_BACKEND=postgrest)
# AUTH_BACKEND=auth0
# AUTH0_DOMAIN=your-tenant.eu.auth0.com
# AUTH0_AUDIENCE=https://api.emithran.com
# AUTH0_CLAIM_NAMESPACE=https://emithran.com/
# Frontend (Regular Web Application in Auth0; callback http://localhost:3000/auth/callback, logout URL http://localhost:3000)
# NEXT_PUBLIC_AUTH_BACKEND=auth0
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_SECRET=      # openssl rand -hex 32
# APP_BASE_URL=http://localhost:3000

# Files in an S3-compatible bucket (AWS S3, Cloudflare R2; locally any S3 server, e.g. SeaweedFS). The download host must also be
# named in TRUSTED_STORAGE_HOSTS so the Next.js file proxy will fetch from it.
# TRUSTED_STORAGE_HOSTS=emithran.<account>.r2.cloudflarestorage.com
# STORAGE_BACKEND=s3
# S3_BUCKET=emithran
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
