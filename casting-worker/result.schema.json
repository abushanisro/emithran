{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emithran.local/schemas/geometry-result-v1.json",
  "title": "geometry-worker result.json, schema version 1 (D107-D109, D117)",
  "description": "What the worker read from one or more STEP files (one product). Millimetres. A measurement that is not meaningful or failed is null and the part lists why in problems. Fields may be added within version 1; consumers ignore unknown fields.",
  "type": "object",
  "required": [
    "schema_version",
    "units",
    "status",
    "model_glb",
    "inputs",
    "assembly",
    "parts",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "units": {
      "const": "mm"
    },
    "status": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "model_glb": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^model\\.glb$"
    },
    "inputs": {
      "description": "Every STEP file given, in order: read or not, and the file whose assembly already holds its content (not repeated in the tree) (D136).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "file",
          "read",
          "inside"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "read": {
            "type": "boolean"
          },
          "inside": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "assembly": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "diagnostics": {
      "type": "object",
      "required": [
        "read_seconds",
        "analyse_seconds",
        "mesh_seconds",
        "triangles",
        "distinct_parts",
        "part_instances",
        "solid_instances",
        "worker_version",
        "occt_version",
        "casting_seconds"
      ],
      "properties": {
        "read_seconds": {
          "type": "number",
          "minimum": 0
        },
        "analyse_seconds": {
          "type": "number",
          "minimum": 0
        },
        "mesh_seconds": {
          "type": "number",
          "minimum": 0
        },
        "triangles": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_parts": {
          "type": "integer",
          "minimum": 1
        },
        "part_instances": {
          "type": "integer",
          "minimum": 0
        },
        "solid_instances": {
          "type": "integer",
          "minimum": 0
        },
        "worker_version": {
          "type": "string"
        },
        "occt_version": {
          "type": "string"
        },
        "casting_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "xyz": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "quantity",
        "instance_ids",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]+(:[0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "assembly",
            "part"
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "file": {
          "description": "Top-level nodes: the input file the node was read from.",
          "type": "string"
        },
        "instance_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+(:[0-9]+)*$"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "part": {
      "type": "object",
      "required": [
        "id",
        "name",
        "total_quantity",
        "valid_as_read",
        "healed",
        "valid",
        "volume_mm3",
        "area_mm2",
        "centre_mm",
        "box_mm",
        "oriented_box_size_mm",
        "solids",
        "faces",
        "edges",
        "face_types",
        "triangles",
        "glb",
        "problems",
        "casting",
        "glb_faces",
        "features"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]+(:[0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "total_quantity": {
          "type": "integer",
          "minimum": 0
        },
        "valid_as_read": {
          "type": "boolean"
        },
        "healed": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        },
        "volume_mm3": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "area_mm2": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "centre_mm": {
          "$ref": "#/$defs/xyz"
        },
        "box_mm": {
          "type": "object",
          "required": [
            "min",
            "max",
            "size"
          ],
          "properties": {
            "min": {
              "$ref": "#/$defs/xyz"
            },
            "max": {
              "$ref": "#/$defs/xyz"
            },
            "size": {
              "$ref": "#/$defs/xyz"
            }
          }
        },
        "oriented_box_size_mm": {
          "$ref": "#/$defs/xyz"
        },
        "solids": {
          "type": "integer",
          "minimum": 0
        },
        "faces": {
          "type": "integer",
          "minimum": 0
        },
        "edges": {
          "type": "integer",
          "minimum": 0
        },
        "face_types": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "triangles": {
          "type": "integer",
          "minimum": 0
        },
        "glb": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^parts/[0-9-]+\\.glb$"
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(empty_shape|no_solid|invalid_geometry|failed:[a-z_]+)$"
          }
        },
        "casting": {
          "$ref": "#/$defs/casting"
        },
        "glb_faces": {
          "description": "The face shown by each primitive of the part GLB, in order",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        }
      }
    },
    "casting": {
      "description": "Casting measurements by ray casting (D126); null when the part has no valid solid or the measurement failed",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "draw_axis",
        "draw_axis_source",
        "draw_depth_mm",
        "projected_area_mm2",
        "parting_line_mm",
        "parting",
        "footprint_mm",
        "hidden_fraction",
        "wall_mm",
        "cores",
        "cores_glb"
      ],
      "properties": {
        "draw_axis": {
          "enum": [
            "x",
            "y",
            "z"
          ],
          "description": "The mould opens along this axis of the part"
        },
        "draw_axis_source": {
          "enum": [
            "auto",
            "requested"
          ],
          "description": "auto: chosen by the worker (fewest hidden regions, then shallowest); requested: given with --draw-axis, and the measurements are along it"
        },
        "draw_depth_mm": {
          "type": "number",
          "minimum": 0
        },
        "projected_area_mm2": {
          "type": "number",
          "minimum": 0
        },
        "parting_line_mm": {
          "description": "The exact parting line's length when it is planar; otherwise the perimeter of the projected outline (outer and inner edges, from the ray grid)",
          "type": "number",
          "minimum": 0
        },
        "parting": {
          "description": "The exact parting line (D144): the outer loop of the part's section across the draw axis where it encloses most; null when not found",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "height_mm",
            "length_mm",
            "area_mm2",
            "outside_fraction",
            "planar",
            "points"
          ],
          "properties": {
            "height_mm": {
              "description": "Position of the parting plane along the draw axis, in part coordinates",
              "type": "number"
            },
            "length_mm": {
              "type": "number",
              "minimum": 0
            },
            "area_mm2": {
              "type": "number",
              "minimum": 0
            },
            "outside_fraction": {
              "description": "Share of the projected area outside the loop",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "planar": {
              "description": "False when the outline is not in one plane: a stepped parting line is needed",
              "type": "boolean"
            },
            "points": {
              "description": "The loop as a closed polyline, part coordinates (mm)",
              "type": "array",
              "items": {
                "$ref": "#/$defs/xyz"
              }
            }
          }
        },
        "footprint_mm": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "hidden_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of the projected area with material hidden from both mould halves (cores, undercuts)"
        },
        "wall_mm": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "min",
            "nominal",
            "max",
            "samples"
          ],
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0
            },
            "nominal": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            },
            "samples": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "cores": {
          "description": "Regions of air enclosed between metal along the draw axis: each needs a sand core (D127); largest first, at most 100",
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "volume_mm3",
              "size_mm",
              "centre_mm",
              "body",
              "faces",
              "problem"
            ],
            "properties": {
              "volume_mm3": {
                "description": "Exact from the core's body when it has one (D145), else by rays",
                "type": "number",
                "minimum": 0
              },
              "body": {
                "description": "A solid was made of its faces; drawn as node \"core <n>\" in cores_glb",
                "type": "boolean"
              },
              "faces": {
                "description": "The part faces it touches (of the features linked to it)",
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "problem": {
                "description": "Why it has no body",
                "enum": [
                  null,
                  "open_boundary",
                  "opening_not_closed",
                  "not_a_solid"
                ]
              },
              "size_mm": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 3,
                "maxItems": 3
              },
              "centre_mm": {
                "$ref": "#/$defs/xyz"
              }
            }
          }
        },
        "cores_glb": {
          "description": "parts/<part>-cores.glb: the cores' bodies, one node \"core <n>\" each (D145); null when none",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "feature": {
      "description": "A recognised casting feature (D132): its faces (indices in glb_faces order terms: TopExp_Explorer order), edge polylines (mm), parameters",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "parent",
        "faces",
        "edges",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z]+:[0-9]+$"
        },
        "type": {
          "enum": [
            "ComboVoid",
            "SimpleHole",
            "MultiStepHole",
            "RingedHole",
            "Ring",
            "Void",
            "PlanarFace",
            "CurvedWall",
            "CurvedSurface",
            "Edge",
            "SharpEdge",
            "NotSupported"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "faces": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/xyz"
            }
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    }
  }
}
