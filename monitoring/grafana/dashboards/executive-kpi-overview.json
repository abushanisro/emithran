{
  "uid": "emithran-executive",
  "title": "Executive KPI Overview",
  "description": "Costing, CAD and BOM outcomes: live (Prometheus) and daily (database).",
  "tags": [
    "emithran",
    "executive"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this dashboard",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Two kinds of numbers on this page.** *Live operational* panels are measured by the running services and scraped by Prometheus (last 24 h window). *Daily business* panels are calculated from database records (`kpi.*` views, migration 933), one row per UTC day, and do not update between runs. A job that is queued or running is neither a success nor a failure in either kind."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Live operational (Prometheus, last 24 h)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CAD processing success rate",
      "description": "Successful uploads / finished uploads (success + final failure) x 100, last 24 h. Retries and running jobs are excluded. Resets to no data when no upload finished.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(increase(emithran_cad_upload_duration_seconds_count{deployment_environment_name=~\"$env\",emithran_outcome=\"ok\"}[24h])) / sum(increase(emithran_cad_upload_duration_seconds_count{deployment_environment_name=~\"$env\",emithran_outcome=~\"ok|error\"}[24h]))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
