    {
      "id": 7,
      "type": "timeseries",
      "title": "Processing time (p95)",
      "description": "p95 duration of successful runs. Costing route comparisons normally take 1-3 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(emithran_cad_upload_duration_seconds_bucket{deployment_environment_name=~\"$env\",emithran_outcome=\"ok\"}[$__rate_interval])))",
          "legendFormat": "CAD upload",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, emithran_operation) (rate(emithran_costing_duration_seconds_bucket{deployment_environment_name=~\"$env\",emithran_outcome=\"ok\"}[$__rate_interval])))",
          "legendFormat": "costing {{emithran_operation}}",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
