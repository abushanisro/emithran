    {
      "id": 33,
      "type": "stat",
      "title": "Uploads: ok (24 h)",
      "description": "Completed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(emithran_cad_upload_duration_seconds_count{deployment_environment_name=~\"$env\",emithran_outcome=\"ok\"}[24h]))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
