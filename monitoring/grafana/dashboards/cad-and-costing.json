          "expr": "histogram_quantile(0.5, sum by (le) (rate(emithran_cad_upload_duration_seconds_bucket{deployment_environment_name=~\"$env\",emithran_outcome=\"ok\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "range": true,
          "instant": false
