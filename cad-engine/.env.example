# CAD Engine Configuration
# Copy this file to .env and fill in your values

# Server Configuration
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO
ENVIRONMENT=development

# File Processing Limits
MAX_FILE_SIZE_MB=50
RATE_LIMIT_PER_MINUTE=10

# Mesh Quality Settings
LINEAR_DEFLECTION=0.1
ANGULAR_DEFLECTION=0.5

# CORS Configuration (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Temporary Directory
TEMP_DIR=/tmp/cad_engine

# AI Enhancement Configuration
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=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
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Optional: Bypass format checks for development
BYPASS_CAD_FORMAT_CHECK=false