# Python bytecode — never needed in the image
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
*.egg-info/
dist/
build/

# IDE / OS noise
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and temp files
*.log
tmp/
temp/
*.tmp

# Local env files — secrets are injected via Railway env vars, not baked in
.env
.env.development
.env.production

# Docs and dev-only files (reduce image size)
README.md
DEPLOYMENT.md
ADVANCED_FEATURES.md
memory.md
