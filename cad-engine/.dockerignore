# Python bytecode — never needed in the image
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
*.egg-info/
dist/
build/

# IDE / OS noise
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and temp files. A bare "*.log" only matches at the top level, so logs/error.log (which can name customer files)
# used to ship inside the image.
logs/
**/*.log
tmp/
temp/
*.tmp

# Tests, their sample files and caches are not part of the runtime image
test/
.pytest_cache/

# Local env files — secrets are injected via Railway env vars, not baked in
.env
.env.*

# Docs and dev-only files (reduce image size)
README.md
RUNNING.md
DEPLOYMENT.md
ADVANCED_FEATURES.md
memory.md
