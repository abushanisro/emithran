{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emithran/cad-engine/assembly.schema.json",
  "title": "POST /analyze/assembly result",
  "description": "Version 1. Fields may be added within a version; consumers ignore unknown fields. A measurement that cannot be taken is null with a code in problems, never an invented number.",
  "type": "object",
  "required": ["schema_version", "units", "status", "inputs", "assembly", "parts", "problems"],
  "properties": {
    "schema_version": { "const": 1 },
    "units": { "const": "mm" },
    "status": { "enum": ["complete", "partial"] },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "status", "inside"],
        "properties": {
          "file": { "type": "string" },
          "status": { "enum": ["ok", "unreadable"] },
          "inside": { "type": ["string", "null"], "description": "File whose assembly already contains this file's root" }
        }
      }
    },
    "assembly": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "file", "quantity_total", "volume_mm3", "surface_area_mm2", "bounding_box"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "file": { "type": "string" },
          "quantity_total": { "type": "integer", "minimum": 1 },
          "volume_mm3": { "type": ["number", "null"] },
          "surface_area_mm2": { "type": ["number", "null"] },
          "bounding_box": {
            "type": ["object", "null"],
            "required": ["length", "width", "height", "diagonal"]
          }
        }
      }
    },
    "problems": {
      "type": "array",
      "items": { "type": "object", "required": ["part", "code"], "properties": { "part": { "type": "string" }, "code": { "type": "string" } } }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["definition", "name", "kind", "quantity", "file", "children"],
      "properties": {
        "definition": { "type": "string", "description": "Document-unique definition id; equals parts[].id when kind is part" },
        "name": { "type": "string" },
        "kind": { "enum": ["part", "assembly", "empty_assembly"] },
        "quantity": { "type": "integer", "minimum": 1, "description": "Instances under the parent" },
        "file": { "type": "string" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    }
  }
}
