{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emithran/cad-engine/forging_geometry.schema.json",
  "title": "Forging geometry extraction result (cad-engine/forging)",
  "description": "Version 1. Fields may be added within a version; consumers ignore unknown fields. This payload measures; it applies no DFM threshold and computes no cost. A measurement that cannot be taken is null with a note in warnings, never an invented number. Not yet produced by any endpoint.",
  "type": "object",
  "required": ["schema_version", "extractor", "units", "parameters", "part", "pull", "selected", "blends", "holes", "revolution", "sections", "warnings"],
  "properties": {
    "schema_version": { "const": 1 },
    "extractor": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "forging_geometry" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Semantic version of the extractor's algorithms; part of the geometry-hash cache key once wired in." }
      }
    },
    "units": { "type": "object", "required": ["length", "area", "volume", "angle"], "properties": { "length": { "const": "mm" }, "area": { "const": "mm2" }, "volume": { "const": "mm3" }, "angle": { "const": "degrees" } } },
    "parameters": {
      "type": "object",
      "required": ["linear_deflection_mm", "draft_threshold_deg"],
      "properties": {
        "linear_deflection_mm": { "type": "number", "exclusiveMinimum": 0, "description": "Tessellation deflection; bounds the accuracy of the mesh-based figures (silhouette area and perimeter, A(x))." },
        "draft_threshold_deg": { "const": 0.01, "description": "The one threshold: staged InsufficientDraftAngle Critical. Used for the zero-draft test and the die-lock test alike." },
        "extra_draft_thresholds_deg": { "type": "array", "items": { "type": "number" } },
        "max_samples_per_face": { "type": "integer", "minimum": 1 },
        "max_rays_per_axis": { "type": "integer", "minimum": 1 },
        "section_stations": { "type": "integer", "minimum": 2 }
      }
    },
    "part": {
      "type": "object",
      "required": ["volume_mm3", "surface_area_mm2", "bounding_box_mm", "longitudinal_ratio", "centre_of_mass_mm"],
      "properties": {
        "volume_mm3": { "type": "number", "minimum": 0 },
        "surface_area_mm2": { "type": "number", "minimum": 0 },
        "bounding_box_mm": { "type": "object", "required": ["length", "width", "height"], "properties": { "length": { "type": "number" }, "width": { "type": "number" }, "height": { "type": "number" } }, "description": "Sorted length >= width >= height." },
        "longitudinal_ratio": { "type": ["number", "null"], "description": "Largest over next-largest box dimension; compared downstream with partLongitudinalRatioThreshold (staged: 2)." },
        "centre_of_mass_mm": { "$ref": "#/$defs/vec3" }
      }
    },
    "pull": {
      "type": "object",
      "required": ["chosen_axis", "tied_axes", "score_definition", "scores", "die_lock_free_axes", "axes"],
      "properties": {
        "chosen_axis": { "enum": ["x", "y", "z"] },
        "tied_axes": { "type": "array", "items": { "enum": ["x", "y", "z"] }, "description": "Empty unless axes scored equal; the first in x, y, z order is chosen." },
        "score_definition": { "type": "string" },
        "scores": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "required": ["axis", "locked_area_mm2", "zero_draft_area_mm2"], "properties": { "axis": { "enum": ["x", "y", "z"] }, "locked_area_mm2": { "type": "number" }, "zero_draft_area_mm2": { "type": "number" } } } },
        "die_lock_free_axes": { "type": "array", "items": { "enum": ["x", "y", "z"] } },
        "axes": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/axis_analysis" } }
      }
    },
    "selected": {
      "type": "object",
      "description": "The chosen axis's headline figures, repeated from pull.axes for convenience.",
      "required": ["axis", "direction", "projected_area_mm2", "parting_perimeter_mm", "footprint_mm", "pull_extent_mm", "has_die_lock", "locked_area_mm2", "zero_draft_area_mm2"],
      "properties": {
        "axis": { "enum": ["x", "y", "z"] },
        "direction": { "$ref": "#/$defs/vec3" },
        "projected_area_mm2": { "type": "number", "minimum": 0, "description": "True silhouette area on the plane normal to the pull (mesh projection union), not a bounding box." },
        "parting_perimeter_mm": { "type": "number", "minimum": 0, "description": "Length of the silhouette's outer boundary: the parting line. Through-openings are not counted." },
        "footprint_mm": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "pull_extent_mm": { "type": "number", "minimum": 0 },
        "has_die_lock": { "type": "boolean" },
        "locked_area_mm2": { "type": "number", "minimum": 0 },
        "zero_draft_area_mm2": { "type": "number", "minimum": 0 }
      }
    },
    "blends": {
      "type": "object",
      "required": ["definition", "blend_count", "min_concave_radius_mm", "min_convex_radius_mm", "blends"],
      "properties": {
        "definition": { "type": "string" },
        "blend_count": { "type": "integer", "minimum": 0 },
        "min_concave_radius_mm": { "type": ["number", "null"], "description": "Smallest fillet radius (material outside the radius). Compared downstream with the staged InsufficientFilletRadius minimum for the material." },
        "min_convex_radius_mm": { "type": ["number", "null"], "description": "Smallest corner/edge round radius (material inside the radius). Compared downstream with InsufficientCornerRadius." },
        "blends": { "type": "array", "items": { "type": "object", "required": ["face_index", "surface_type", "radius_mm", "concave", "area_mm2"], "properties": { "face_index": { "type": "integer" }, "surface_type": { "enum": ["cylinder", "torus", "sphere"] }, "radius_mm": { "type": "number" }, "concave": { "type": "boolean" }, "area_mm2": { "type": "number" }, "axis": { "$ref": "#/$defs/vec3" }, "axis_angle_to_pull_deg": { "type": "number" } } } }
      }
    },
    "holes": {
      "type": "array",
      "items": { "type": "object", "required": ["diameter_mm", "depth_mm", "blind", "axis", "axis_angle_to_pull_deg"], "properties": { "diameter_mm": { "type": "number" }, "depth_mm": { "type": "number" }, "length_to_diameter": { "type": ["number", "null"] }, "blind": { "type": "boolean" }, "axis": { "$ref": "#/$defs/vec3" }, "axis_angle_to_pull_deg": { "type": "number" }, "centroid_mm": { "$ref": "#/$defs/vec3" }, "face_indices": { "type": "array", "items": { "type": "integer" } } } }
    },
    "revolution": {
      "type": "object",
      "required": ["by_axis", "best_axis", "best_fraction"],
      "properties": {
        "definition": { "type": "string" },
        "by_axis": { "type": "object", "required": ["x", "y", "z"], "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } },
        "best_axis": { "enum": ["x", "y", "z"] },
        "best_fraction": { "type": "number", "minimum": 0, "maximum": 1, "description": "Compared downstream with surfaceAreaThreshold2D (staged 0.95) and surfaceAreaThreshold2_5D (0.75)." }
      }
    },
    "wall_thickness": {
      "type": ["object", "null"],
      "description": "casting_geometry.wall_thickness_profile figures plus the solid shadow area used to band ThinSection. null when not measured (see warnings).",
      "properties": { "solid_shadow_area_mm2": { "type": "number" }, "solid_shadow_area_basis": { "type": "string" } }
    },
    "sections": {
      "type": "object",
      "required": ["axis", "stations"],
      "properties": {
        "axis": { "enum": ["x", "y", "z", null] },
        "direction": { "$ref": "#/$defs/vec3" },
        "origin_mm": { "type": "number" },
        "length_mm": { "type": "number" },
        "stations": { "type": "integer", "minimum": 0 },
        "station_spacing_mm": { "type": "number" },
        "x_mm": { "type": "array", "items": { "type": "number" }, "description": "Station positions from the part's minimum along the axis (cell midpoints)." },
        "area_mm2": { "type": "array", "items": { "type": "number" }, "description": "Section area at each station: A(x). Inner boundaries subtract." },
        "max_area_mm2": { "type": "number" },
        "max_area_x_mm": { "type": "number" },
        "equivalent_radius": { "type": "object", "properties": { "mean_mm": { "type": "number" }, "std_mm": { "type": "number" }, "coefficient_of_variation": { "type": ["number", "null"] } } },
        "integrated_volume_mm3": { "type": "number" },
        "volume_check_ratio": { "type": "number", "description": "Integral of A(x) over the exact volume; 1 means the curve is consistent with the solid." }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "axis_analysis": {
      "type": "object",
      "required": ["axis", "direction", "silhouette", "die_lock", "draft", "sampled_area_mm2"],
      "properties": {
        "axis": { "enum": ["x", "y", "z"] },
        "direction": { "$ref": "#/$defs/vec3" },
        "silhouette": { "type": "object", "required": ["projected_area_mm2", "parting_perimeter_mm", "footprint_mm", "pull_extent_mm"] },
        "die_lock": {
          "type": "object",
          "required": ["has_die_lock", "locked_area_mm2", "locked_fraction", "locked_sample_count", "tested_sample_count", "locked_face_indices"],
          "properties": { "has_die_lock": { "type": "boolean" }, "locked_area_mm2": { "type": "number" }, "locked_fraction": { "type": "number" }, "locked_sample_count": { "type": "integer" }, "tested_sample_count": { "type": "integer" }, "locked_face_indices": { "type": "array", "items": { "type": "integer" } } }
        },
        "draft": {
          "type": "object",
          "required": ["zero_draft_area_mm2", "min_deg", "area_below_deg"],
          "properties": { "zero_draft_area_mm2": { "type": "number" }, "min_deg": { "type": "number" }, "area_below_deg": { "type": "object", "additionalProperties": { "type": "number" }, "description": "Surface area (mm2) whose draft is below each threshold in degrees (key = threshold). Always includes 0.01." } }
        },
        "sampled_area_mm2": { "type": "number" },
        "faces": {
          "type": "array",
          "items": { "type": "object", "required": ["face_index", "surface_type", "area_mm2", "draft_min_deg", "draft_max_deg", "locked_fraction", "facing"], "properties": { "face_index": { "type": "integer" }, "surface_type": { "type": "string" }, "area_mm2": { "type": "number" }, "draft_min_deg": { "type": "number" }, "draft_max_deg": { "type": "number" }, "draft_mean_deg": { "type": ["number", "null"] }, "locked_fraction": { "type": "number" }, "facing": { "enum": ["pull", "anti_pull", "parallel", "mixed"] } } }
        }
      }
    }
  }
}
