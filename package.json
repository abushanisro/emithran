{
  "name": "mithran-nextjs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('fs').copyFileSync('.env.development','.env')\" && next dev",
    "dev:prod": "node -e \"require('fs').copyFileSync('.env.production','.env')\" && next dev",
    "build": "next build",
    "build:dev": "node -e \"require('fs').copyFileSync('.env.development','.env')\" && next build",
    "build:prod": "node -e \"require('fs').copyFileSync('.env.production','.env')\" && next build",
    "start": "node .next/standalone/server.js",
    "start:production": "NODE_ENV=production node .next/standalone/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "switch:dev": "node -e \"require('fs').copyFileSync('.env.development','.env')\" && echo Switched to development environment",
    "switch:prod": "node -e \"require('fs').copyFileSync('.env.production','.env')\" && echo Switched to production environment",
    "test:e2e": "playwright test"
  },
