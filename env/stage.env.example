# STAGE environment. Copy to env/stage.env on the STAGE host and fill in the secrets. env/*.env is ignored by git.
APP_ENV=stage

# Supabase project mhhyilxeoxzlbiytwdcm
SUPABASE_URL=https://mhhyilxeoxzlbiytwdcm.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Only the migration runner and the nightly backup use a database connection (session-mode pooler, port 5432); the app holds none.
MIGRATE_DATABASE_URL=postgresql://postgres.mhhyilxeoxzlbiytwdcm:REPLACE_ME@REPLACE_POOLER_HOST:5432/postgres

# The one upload limit in MB (backend, engine and the upload card all follow it). 50 is the Supabase free tier's cap on one
# stored object; set 100 after moving to a paid plan.
MAX_UPLOAD_MB=50

# Cloudflare Tunnel token (Zero Trust, Networks, Tunnels). The tunnel is the only way into this host.
TUNNEL_TOKEN=REPLACE_ME

# Public URLs of this environment. The engines are private and have no public URL.
# One public URL for the whole app; Cloudflare routes /v1/* to the backend (docs/DEPLOYMENT_SECURITY.md).
NEXT_PUBLIC_API_GATEWAY_URL=https://REPLACE_APP_HOST
CORS_ORIGIN=https://REPLACE_APP_HOST

# Shared secrets: openssl rand -hex 32
CAD_ENGINE_API_KEY=REPLACE_ME
ECAD_ENGINE_API_KEY=REPLACE_ME

# Data backend. `supabase` = today. `postgrest` = plain managed Postgres behind the postgrest service (start with: --profile postgrest),
# with Auth0 login (docs/ENGINEERING.md "Leaving Supabase"). Fill these only when switching.
DB_BACKEND=supabase
# Files: `supabase` today; `s3` for S3, Cloudflare R2 or MinIO (one bucket, one key limited to it)
STORAGE_BACKEND=supabase
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# openssl rand -hex 32. The backend signs database tokens with it and PostgREST verifies them with it; never shared with the browser.
DB_JWT_SECRET=
# Connection string of the `authenticator` role (set its password outside git): postgres://authenticator:...@HOST:5432/DB?sslmode=require
POSTGREST_DB_URI=
