# STAGE environment. Copy to env/stage.env on the STAGE host and fill in the secrets. env/*.env is ignored by git.
APP_ENV=stage

# Database: managed Postgres 16+ (RDS, Cloud SQL, Azure, Neon...). Only the migration runner and the nightly backup connect to it
# directly; the app reaches it through the postgrest service.
MIGRATE_DATABASE_URL=postgresql://postgres:REPLACE_ME@REPLACE_DB_HOST:5432/postgres?sslmode=require

# The one upload limit in MB (backend, engine and the upload card all follow it).
MAX_UPLOAD_MB=50

# Sign-in: Auth0 (docs/CUTOVER_AUTH0_POSTGRES.md). The web app's client secret and session secret are server-side only.
AUTH0_DOMAIN=REPLACE_TENANT.auth0.com
AUTH0_AUDIENCE=https://api.emithran.com
AUTH0_CLAIM_NAMESPACE=https://emithran.com/
AUTH0_CLIENT_ID=REPLACE_ME
AUTH0_CLIENT_SECRET=REPLACE_ME
# openssl rand -hex 32
AUTH0_SECRET=REPLACE_ME
APP_BASE_URL=https://REPLACE_APP_HOST

# Cloudflare Tunnel token (Zero Trust, Networks, Tunnels). The tunnel is the only way into this host.
TUNNEL_TOKEN=REPLACE_ME

# Public URLs of this environment. The engines are private and have no public URL.
# One public URL for the whole app; Cloudflare routes /v1/* to the backend (docs/DEPLOYMENT_SECURITY.md).
NEXT_PUBLIC_API_GATEWAY_URL=https://REPLACE_APP_HOST
CORS_ORIGIN=https://REPLACE_APP_HOST

# Shared secrets: openssl rand -hex 32
CAD_ENGINE_API_KEY=REPLACE_ME
ECAD_ENGINE_API_KEY=REPLACE_ME

# Files: an S3-compatible bucket (S3, Cloudflare R2, MinIO), one bucket and one key limited to it. Name its download host in
# TRUSTED_STORAGE_HOSTS so the file proxy and the browser's 3D viewer may fetch from it.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
TRUSTED_STORAGE_HOSTS=
# openssl rand -hex 32. The backend signs database tokens with it and PostgREST verifies them with it; never shared with the browser.
DB_JWT_SECRET=
# Connection string of the `authenticator` role (set its password outside git): postgres://authenticator:...@HOST:5432/DB?sslmode=require
POSTGREST_DB_URI=

# --- Monitoring (docker-compose.monitoring.yml, docs/ops/monitoring.md). Optional: leave the OTEL_* values empty to keep telemetry off. ---
# Where the backend and engines send telemetry. Metrics to Prometheus; the base endpoint is the OTLP trace backend (or Prometheus'
# own /api/v1/otlp for metrics only, with OTEL_TRACES_SAMPLER_ARG=0).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.1
# The monitoring stack attaches to the app's networks (named after the app's compose project, e.g. emithran-stage_internal).
APP_INTERNAL_NETWORK=
APP_EDGE_NETWORK=
GRAFANA_ADMIN_USER=admin
# Generate: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
# Generate: openssl rand -hex 32
GRAFANA_SECRET_KEY=
GRAFANA_ROOT_URL=
GRAFANA_COOKIE_SECURE=true
# The read-only business-KPI role (migration 933). Enable it with ALTER ROLE grafana_reader WITH LOGIN PASSWORD '...' (outside git).
# Leave GRAFANA_PG_HOST empty to run Grafana without it.
GRAFANA_PG_HOST=
GRAFANA_PG_DATABASE=postgres
GRAFANA_PG_USER=grafana_reader
GRAFANA_PG_PASSWORD=
GRAFANA_PG_SSLMODE=require
# Prometheus retention: whichever limit is reached first.
PROM_RETENTION_TIME=15d
PROM_RETENTION_SIZE=5GB
