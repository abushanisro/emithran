# STAGE environment. Copy to env/stage.env on the STAGE host and fill in the secrets. env/*.env is ignored by git.
APP_ENV=stage

# Database: managed Postgres 16+ (RDS, Cloud SQL, Azure, Neon...). Only the migration runner and the nightly backup connect to it
# directly; the app reaches it through the postgrest service.
MIGRATE_DATABASE_URL=postgresql://postgres:REPLACE_ME@REPLACE_DB_HOST:5432/postgres?sslmode=require
# The provider's CA certificate (PEM file path) so db:migrate verifies the server; without it the link is encrypted but not
# authenticated. Supabase: Project Settings → Database → SSL configuration → Download certificate.
# MIGRATE_DATABASE_SSL_CA=/absolute/path/to/prod-ca-2021.crt

# Should-cost calibration (npm run should-cost:calibrate, operator-run): a (process, location) cell is recalibrated only with
# actual/prediction pairs from at least this many organizations, so one tenant cannot move the shared benchmark rates. Default 2;
# lower is refused.
# SHOULD_COST_CALIBRATION_MIN_ORGANIZATIONS=2

# The one upload limit in MB (backend, engine and the upload card all follow it).
MAX_UPLOAD_MB=50

# Sign-in: Auth0 (docs/CUTOVER_AUTH0_POSTGRES.md). The web app's client secret and session secret are server-side only.
AUTH0_DOMAIN=REPLACE_TENANT.auth0.com
AUTH0_AUDIENCE=https://api.emithran.com
AUTH0_CLAIM_NAMESPACE=https://emithran.com/
# Auth0 connections whose verified email may link a new login to an invited account (decision D3): the SSO connection
# (= NEXT_PUBLIC_AUTH0_SSO_CONNECTION), the Workspace connection and the database connection, names exactly as in Auth0. Required.
AUTH0_TRUSTED_CONNECTIONS=google-oauth2,emithran-auth,Username-Password-Authentication
# The "Sign in with SSO" button's connection (build time). Google, limited to company domains by an Auth0 Action (docs/ops/sso.md). Blank: no button.
NEXT_PUBLIC_AUTH0_SSO_CONNECTION=google-oauth2
AUTH0_CLIENT_ID=REPLACE_ME
AUTH0_CLIENT_SECRET=REPLACE_ME
# openssl rand -hex 32
AUTH0_SECRET=REPLACE_ME
APP_BASE_URL=https://REPLACE_APP_HOST
# Shared by the frontend BFF and the backend: signs the client address the BFF forwards. openssl rand -hex 32
BFF_FORWARD_SECRET=REPLACE_ME

# AI. The key lives only on the backend; unset = AI features answer 503. AI_DISABLED=true is the kill switch (every AI call refused).
# Daily token budgets (per UTC day) are optional; the defaults are shown.
ANTHROPIC_API_KEY=
# AI_DISABLED=false
# AI_USER_DAILY_TOKENS=2000000
# AI_ORG_DAILY_TOKENS=20000000
# AI_GLOBAL_DAILY_TOKENS=50000000
# AI_MAX_CONCURRENT_PER_USER=2

# Limits and abuse controls (optional; defaults shown; an invalid value stops the backend at boot).
# AUTH_DECISION_CACHE_SECONDS=10     # how long a removed user can keep access (0-60)
# ORG_THROTTLE_LIMIT=3000            # requests per ORG_THROTTLE_TTL ms for one organization
# ORG_THROTTLE_TTL=60000
# ARCHIVE_MAX_EXPANDED_MB=256        # what a CAD or electronics .zip may expand to
# HEAVY_WORK_MAX_CONCURRENT=2        # workbook/archive parses at once per backend process
# HEAVY_WORK_MAX_PER_TENANT=1
# The 30-minute inactivity sign-out (with its warning). false: people stay signed in until Auth0's own session ends.
SESSION_IDLE_TIMEOUT_ENABLED=true
# The sand-casting worker (casting-worker/README.md): set, stage-release.sh starts it (compose profile sand-casting) and Apply waits for its
# casting analysis; empty, sand-cast parts are costed with the cad-engine's casting measurements. It needs up to 2 GB of memory.
CASTING_WORKER_SOCKET=/run/casting-worker/worker.sock

# A budget FX rate change beyond this % of the current rate needs the admin's explicit confirmation.
# FX_RATE_MAX_CHANGE_PERCENT=10

# Cloudflare Tunnel token (Zero Trust, Networks, Tunnels). The tunnel is the only way into this host.
TUNNEL_TOKEN=REPLACE_ME

# Public URLs of this environment. The engines are private and have no public URL.
# One public URL for the whole app; Cloudflare routes /v1/* to the backend (docs/DEPLOYMENT_SECURITY.md).
NEXT_PUBLIC_API_GATEWAY_URL=https://REPLACE_APP_HOST
CORS_ORIGIN=https://REPLACE_APP_HOST

# Shared secrets: openssl rand -hex 32
CAD_ENGINE_API_KEY=REPLACE_ME
ECAD_ENGINE_API_KEY=REPLACE_ME

# Files: an S3-compatible bucket (S3, Cloudflare R2, MinIO), one bucket and one key limited to it. Name its download host in
# TRUSTED_STORAGE_HOSTS so the file proxy and the browser's 3D viewer may fetch from it.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
TRUSTED_STORAGE_HOSTS=
# openssl rand -hex 32. The backend signs database tokens with it and PostgREST verifies them with it; never shared with the browser.
DB_JWT_SECRET=
# Connection string of the `authenticator` role (set its password outside git): postgres://authenticator:...@HOST:5432/DB?sslmode=require
POSTGREST_DB_URI=

# --- Monitoring (docker-compose.monitoring.yml, docs/ops/monitoring.md). Optional: leave the OTEL_* values empty to keep telemetry off. ---
# Where the backend and engines send telemetry. Metrics to Prometheus; the base endpoint is the OTLP trace backend (or Prometheus'
# own /api/v1/otlp for metrics only, with OTEL_TRACES_SAMPLER_ARG=0).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.1
# The monitoring stack attaches to the app's networks (named after the app's compose project, e.g. emithran-stage_internal).
APP_INTERNAL_NETWORK=
APP_EDGE_NETWORK=
GRAFANA_ADMIN_USER=admin
# Generate: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
# Generate: openssl rand -hex 32
GRAFANA_SECRET_KEY=
GRAFANA_ROOT_URL=
GRAFANA_COOKIE_SECURE=true
# The read-only business-KPI role (migration 933). Enable it with ALTER ROLE grafana_reader WITH LOGIN PASSWORD '...' (outside git).
# Leave GRAFANA_PG_HOST empty to run Grafana without it.
GRAFANA_PG_HOST=
GRAFANA_PG_DATABASE=postgres
GRAFANA_PG_USER=grafana_reader
GRAFANA_PG_PASSWORD=
GRAFANA_PG_SSLMODE=require
# Prometheus retention: whichever limit is reached first.
PROM_RETENTION_TIME=15d
PROM_RETENTION_SIZE=5GB
