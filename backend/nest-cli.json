{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "tsConfigPath": "tsconfig.build.json",
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/bom-items/costing/plastic-molding/reference/*.csv",
        "watchAssets": true
      }
    ],
    "watchAssets": false
  }
}
