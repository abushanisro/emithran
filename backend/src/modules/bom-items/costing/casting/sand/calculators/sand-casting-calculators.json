          "formula": "{Metal Density} * ({Heat of Fusion} + {Specific Heat Liquid} * {Superheat}) / ({Liquidus} - {Mould Temperature})"
        },
        {
          "name": "Mould Constant",
          "unit": "s/m²",
          "formula": "{Heat Term} ^ 2 * pi / (4 * {Sand Conductivity} * {Sand Density} * {Sand Specific Heat})"
        },
        {
          "name": "Cooling Time",
          "unit": "s",
          "formula": "{Mould Constant} * ({Modulus} / 1000) ^ {Exponent}"
        },
        {
          "name": "Cycle Time",
          "unit": "s",
          "formula": "{Cooling Time} / {Cavities}"
        }
      ]
    },
