          "unit": null,
          "source": {
            "engine": "final_yield"
          }
        },
        {
          "name": "Melt Loss",
          "unit": "kg",
          "formula": "{Poured Weight} / {Furnace Yield Loss Factor} - {Poured Weight}"
        },
        {
          "name": "Bought Weight",
          "unit": "kg",
          "formula": "{Net Weight} + {Melt Loss} + ({Poured Weight} - {Net Weight}) * (1 - min(max({Remelt Allowance}, 0), 1))"
        },
        {
          "name": "Material Cost",
          "unit": "USD",
          "formula": "{Bought Weight} * {Price} / {Final Yield}"
        }
      ]
    },
