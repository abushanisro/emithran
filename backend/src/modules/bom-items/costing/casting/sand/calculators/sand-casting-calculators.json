            "engine": "ingates"
          }
        },
        {
          "name": "Sprue Multiplier",
          "unit": null,
          "source": {
            "variable": "sprueMultiplier"
          }
        },
        {
          "name": "Runner Multiplier",
          "unit": null,
          "source": {
            "variable": "runnerMultiplier"
          }
        },
        {
          "name": "Ingate Multiplier",
          "unit": null,
          "source": {
            "variable": "ingateMultiplier"
          }
        },
        {
          "name": "Efficiency",
          "unit": null,
          "source": {
            "lookup": "tblGatingRatios.Efficiency Coefficient"
          }
        },
        {
          "name": "Well Area Ratio",
          "unit": null,
          "source": {
            "variable": "sprueWellAreaToWellBase"
          }
        },
        {
          "name": "Runner Aspect Ratio",
          "unit": null,
          "source": {
            "variable": "runnerAspectRatio"
          }
        },
        {
          "name": "Ingate Aspect Ratio",
          "unit": null,
          "source": {
            "variable": "ingateAspectRatio"
          }
        },
        {
          "name": "Ingate Length Ratio",
          "unit": null,
          "source": {
            "variable": "ingateLengthToPartLength"
          }
        },
        {
          "name": "Well Depth to Runner Height (standard rule)",
          "unit": null,
          "formula": "2"
        },
        {
          "name": "Pour Time",
          "unit": "s",
          "formula": "{Pouring Coefficient} * sqrt({Poured per Mould} / 0.45359237)"
        },
        {
          "name": "Effective Head",
          "unit": "mm",
          "formula": "{Cope Height} - {Casting Height in Cope} / 2"
        },
        {
          "name": "Choke Area",
          "unit": "mm²",
          "formula": "{Poured per Mould} / ({Density} * {Pour Time} * {Efficiency} * sqrt(2 * 9.81 * {Effective Head} / 1000)) * 1e6"
        },
        {
          "name": "Smallest Multiplier",
          "unit": null,
          "formula": "min({Sprue Multiplier}, {Runner Multiplier}, {Ingate Multiplier})"
        },
        {
          "name": "Sprue Area",
          "unit": "mm²",
          "formula": "{Choke Area} * {Sprue Multiplier} / {Smallest Multiplier}"
        },
        {
          "name": "Runner Area",
          "unit": "mm²",
          "formula": "{Choke Area} * {Runner Multiplier} / {Smallest Multiplier} / {Cavities}"
        },
        {
          "name": "Ingate Area",
          "unit": "mm²",
          "formula": "{Choke Area} * {Ingate Multiplier} / {Smallest Multiplier} / {Cavities}"
        },
        {
          "name": "Sprue Diameter",
          "unit": "mm",
          "formula": "sqrt(4 * {Sprue Area} / pi)"
        },
        {
          "name": "Sprue Height",
          "unit": "mm",
          "formula": "{Cope Height}"
        },
        {
          "name": "Well Diameter",
          "unit": "mm",
          "formula": "sqrt(4 * {Well Area Ratio} * {Sprue Area} / pi)"
        },
        {
          "name": "Runner Height",
          "unit": "mm",
          "formula": "sqrt({Runner Area} / {Runner Aspect Ratio})"
        },
        {
          "name": "Runner Width",
          "unit": "mm",
          "formula": "{Runner Aspect Ratio} * {Runner Height}"
        },
        {
          "name": "Well Depth",
          "unit": "mm",
          "formula": "{Well Depth to Runner Height (standard rule)} * {Runner Height}"
        },
        {
          "name": "Ingate Length",
          "unit": "mm",
          "formula": "{Ingate Length Ratio} * {Part Length}"
        },
        {
          "name": "Runner Length",
          "unit": "mm",
          "formula": "{Part Length} + {Ingate Length}"
        },
        {
          "name": "Ingate Height",
          "unit": "mm",
          "formula": "sqrt({Ingate Area} / {Ingates} / {Ingate Aspect Ratio})"
        },
        {
          "name": "Ingate Width",
          "unit": "mm",
          "formula": "{Ingate Aspect Ratio} * {Ingate Height}"
        },
        {
          "name": "Sprue and Well per Casting",
          "unit": "mm³",
          "formula": "({Sprue Area} * {Sprue Height} + pi / 4 * {Well Diameter} ^ 2 * {Well Depth}) / {Cavities}"
        },
        {
          "name": "Runner and Ingates",
          "unit": "mm³",
          "formula": "{Runner Area} * {Runner Length} + {Ingate Area} * {Ingate Length}"
        },
        {
          "name": "Gating Weight",
          "unit": "kg",
          "formula": "({Sprue and Well per Casting} + {Runner and Ingates}) / 1e9 * {Density}"
        }
      ]
    },
