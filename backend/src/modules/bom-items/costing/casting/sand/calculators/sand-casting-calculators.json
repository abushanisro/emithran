{
  "domain": "sand casting",
  "processGroup": "Sand Casting",
  "calculators": [
    {
      "key": "sand.risers",
      "name": "Sand Casting - Risers",
      "description": "Risers by the modulus method with its feed-volume check (D146): each riser's modulus is the casting's (volume / surface) times a factor, so it freezes after the casting; and the risers hold the metal the casting and they shrink by, of which a riser gives only its feed efficiency. A cylinder cooling through its side and top, the larger of the two sizes. Factor, shape and efficiency are the standard rules, the shrinkage the alloy family's typical value, until the plant sets its own. One riser per ingate.",
      "operations": [],
      "helper": true,
      "output": "Riser Weight",
      "results": [
        "Riser Diameter",
        "Riser Height"
      ],
      "fields": [
        {
          "name": "Casting Modulus",
          "unit": "mm",
          "source": {
            "cad": "modulus_mm"
          }
        },
        {
          "name": "Casting Volume",
          "unit": "mm³",
          "source": {
            "cad": "volume_mm3"
          }
        },
        {
          "name": "Density",
          "unit": "kg/m³",
          "source": {
            "material": "density_kg_m3"
          }
        },
        {
          "name": "Risers",
          "unit": null,
          "source": {
            "engine": "risers"
          }
        },
        {
          "name": "Shrinkage (estimate)",
          "unit": "%",
          "source": {
            "engine": "shrinkage_pct"
          }
        },
        {
          "name": "Riser Modulus Factor (standard rule)",
          "unit": null,
          "formula": "1.2"
        },
        {
          "name": "Height to Diameter (standard rule)",
          "unit": null,
          "formula": "1.5"
        },
        {
          "name": "Feed Efficiency (standard rule)",
          "unit": "%",
          "formula": "14"
        },
        {
          "name": "Riser Modulus",
          "unit": "mm",
          "formula": "{Casting Modulus} * {Riser Modulus Factor (standard rule)}"
        },
        {
          "name": "Diameter by Modulus",
          "unit": "mm",
          "formula": "{Riser Modulus} * (4 * {Height to Diameter (standard rule)} + 1) / {Height to Diameter (standard rule)}"
        },
        {
          "name": "Feed Volume per Riser",
          "unit": "mm³",
          "formula": "{Shrinkage (estimate)} * {Casting Volume} / ({Feed Efficiency (standard rule)} - {Shrinkage (estimate)}) / {Risers}"
        },
        {
          "name": "Diameter by Feeding",
          "unit": "mm",
          "formula": "(4 * {Feed Volume per Riser} / (pi * {Height to Diameter (standard rule)})) ^ (1 / 3)"
        },
        {
          "name": "Riser Diameter",
          "unit": "mm",
          "formula": "max({Diameter by Modulus}, {Diameter by Feeding})"
        },
        {
          "name": "Riser Height",
          "unit": "mm",
          "formula": "{Riser Diameter} * {Height to Diameter (standard rule)}"
        },
        {
          "name": "Riser Volume",
          "unit": "mm³",
          "formula": "pi / 4 * {Riser Diameter} ^ 2 * {Riser Height}"
        },
        {
          "name": "Riser Weight",
          "unit": "kg",
          "formula": "{Risers} * {Riser Volume} / 1e9 * {Density}"
        }
      ]
    },
    {
      "key": "sand.gating",
      "name": "Sand Casting - Gating system",
      "description": "Sprue, sprue well, runner and ingates (D146): the choke area lets the metal of one mould in within the pouring time under the cope's head (the casting gated at the parting line: half its height in the cope is lost), at the gating ratio's efficiency; the sprue, runner and ingates follow the plant's ratio, and their shapes the plant's aspect ratios. One sprue a mould; a runner and ingates per casting.",
      "operations": [],
      "helper": true,
      "output": "Gating Weight",
      "results": [
        "Pour Time",
        "Effective Head",
        "Choke Area",
        "Sprue Diameter",
        "Sprue Height",
        "Well Diameter",
        "Well Depth",
        "Runner Width",
        "Runner Height",
        "Runner Length",
        "Ingate Width",
        "Ingate Height",
        "Ingate Length",
        "Ingate Area"
      ],
      "fields": [
        {
          "name": "Poured per Mould",
          "unit": "kg",
          "source": {
            "engine": "poured_per_mould_kg"
          }
        },
        {
