     "name": "Tack Time",
     "unit": "s",
     "formula": "{Weld Length} / max({Tack Pitch}, 1) * {Tack Length} / {Travel Speed}"
    },
    {
     "name": "Gun Time",
     "unit": "s",
     "formula": "{Welds} * {Gun Placement Time} + {Arc Time} * {Gun Clean Per Arc}"
    },
