  {
   "key": "assembly.manual_mig",
   "name": "Assembly - Manual MIG welding",
   "operations": [
    "Manual MIG Welding"
   ],
   "results": [
    "Arc Time",
    "Tack Time"
   ],
   "description": "Manual MIG welding, per weld joint: the arc time over its length at the travel speed for its material, throat and gas, in the passes its throat takes (tblNumWeldPasses), times the machine's arc time standard; tacks every tack pitch; the gun placed for each weld and cleaned for its share of the arc (the machine's gun clean time per arc). A manual weld's arc and tacks are over weldingEfficiencyFactor, for fixturing, clamping, moving and cooling.",
   "fields": [
    {
     "name": "Weld Length",
     "unit": "mm",
     "source": {
      "engine": "weld_length_mm (the joint's weld length)"
     }
    },
    {
     "name": "Welds",
     "unit": null,
     "source": {
      "engine": "weld_count (the joint's welds)"
     }
    },
    {
     "name": "Passes",
     "unit": null,
     "source": {
      "lookup": "tblNumWeldPasses.Num Passes"
     }
    },
    {
     "name": "Travel Speed",
     "unit": "mm/s",
     "source": {
      "engine": "travel_speed_mm_s (tblWeldTravelSpeed for MIG; tblTigWeldingV2 with its position multiplier for TIG)"
     }
    },
    {
     "name": "Arc Time Standard",
     "unit": null,
     "source": {
      "machine": "arc_time_std"
     }
    },
    {
     "name": "Gun Placement Time",
     "unit": "s",
     "source": {
      "machine": "gun_placement_time_s"
     }
    },
    {
     "name": "Gun Clean Per Arc",
     "unit": "s",
     "source": {
      "machine": "gun_clean_time_per_arc_s"
     }
    },
    {
     "name": "Tack Pitch",
     "unit": "mm",
     "source": {
      "machine": "tack_pitch_mm"
     }
    },
    {
     "name": "Tack Length",
     "unit": "mm",
     "source": {
      "machine": "tack_length_mm"
     }
    },
    {
     "name": "Efficiency",
     "unit": null,
     "source": {
      "engine": "efficiency (weldingEfficiencyFactor for a manual weld, 1 for a robot)"
     }
    },
    {
     "name": "Cycle Time Factor",
     "unit": null,
     "source": {
      "variable": "cycleTimeAdjustmentFactor"
     }
    },
    {
     "name": "Arc Time",
     "unit": "s",
     "formula": "{Weld Length} * {Passes} / {Travel Speed} * {Arc Time Standard}"
    },
    {
     "name": "Tack Time",
     "unit": "s",
     "formula": "{Weld Length} / max({Tack Pitch}, 1) * {Tack Length} / {Travel Speed}"
    },
    {
     "name": "Gun Time",
     "unit": "s",
     "formula": "{Welds} * {Gun Placement Time} + {Arc Time} * {Gun Clean Per Arc}"
    },
    {
     "name": "Cycle Time",
     "unit": "s",
     "formula": "(({Arc Time} + {Tack Time}) / {Efficiency} + {Gun Time}) * {Cycle Time Factor}"
    }
   ]
  },
