{
 "domain": "assembly",
 "processGroup": "Assembly",
 "calculators": [
  {
   "key": "assembly.weld_consumables",
   "name": "Assembly - Weld consumables",
   "helper": true,
   "operations": [],
   "output": "Consumables Cost",
   "results": [
    "Wire Mass",
    "Wire Cost",
    "Gas Cost",
    "Tip and Nozzle Cost",
    "Spray Cost"
   ],
   "description": "What an arc weld consumes per assembly: the filler wire fed during the arc time (its feed speed and diameter at the weld metal's density, priced at the machine's wire cost), the shielding gas (the travel-speed table's gas cost per hour of arc), the contact tips and nozzles worn per kilogram of wire (weldTipReplacementRate, weldNozzleReplacementRate at weldTipCost, weldNozzleCost) and, when weldAntiSpatterSprayEnabled, the anti-spatter spray along the weld (tblWeldAntiSpatterSpray).",
   "fields": [
    {
     "name": "Arc Time",
     "unit": "s",
     "source": {
      "engine": "arc_time_s (the weld's arc time)"
     }
    },
    {
     "name": "Weld Length",
     "unit": "mm",
     "source": {
      "engine": "weld_length_mm"
     }
    },
    {
     "name": "Wire Feed Speed",
     "unit": "mm/s",
     "source": {
      "engine": "wire_feed_speed_mm_s (tblWeldTravelSpeed for MIG, the machine's wire feed rate for TIG)"
     }
    },
    {
     "name": "Wire Diameter",
     "unit": "mm",
     "source": {
      "engine": "wire_diameter_mm (tblWeldTravelSpeed wire diameter, the TIG table's filler rod)"
     }
    },
    {
     "name": "Weld Density",
     "unit": "kg/m³",
     "source": {
      "engine": "weld_density_kg_m3 (the machine's weld density, else the metal's)"
     }
    },
    {
     "name": "Wire Cost Per kg",
     "unit": "USD/kg",
     "source": {
      "machine": "wire_cost_usd_per_kg"
     }
    },
    {
     "name": "Gas Cost Per Hour",
     "unit": "USD/hr",
     "source": {
      "engine": "gas_cost_usd_hr (the travel-speed table's gas cost)"
     }
    },
    {
     "name": "Tip Cost",
     "unit": "USD",
     "source": {
      "variable": "weldTipCost"
     }
    },
    {
     "name": "Tip Life",
     "unit": "kg",
     "source": {
      "variable": "weldTipReplacementRate"
     }
    },
    {
     "name": "Nozzle Cost",
     "unit": "USD",
     "source": {
      "variable": "weldNozzleCost"
     }
    },
    {
     "name": "Nozzle Life",
     "unit": "kg",
     "source": {
      "variable": "weldNozzleReplacementRate"
     }
    },
    {
     "name": "Spray On",
     "unit": "",
     "source": {
      "engine": "spray_on (1 when weldAntiSpatterSprayEnabled, else 0)"
     }
    },
    {
     "name": "Spray Cost Per Can",
     "unit": "USD",
     "source": {
      "lookup": "tblWeldAntiSpatterSpray.Spray Cost (USD)"
     }
    },
    {
     "name": "Spray Volume",
     "unit": "mL",
     "source": {
      "lookup": "tblWeldAntiSpatterSpray.Volume (mL)"
     }
    },
    {
     "name": "Spray Discharge",
     "unit": "g/s",
     "source": {
      "lookup": "tblWeldAntiSpatterSpray.Discharge Rate (g / s)"
     }
    },
    {
     "name": "Spray Density",
     "unit": "g/cm³",
     "source": {
      "lookup": "tblWeldAntiSpatterSpray.Relative Density (g / cm^3)"
     }
    },
    {
     "name": "Spray Time Per Length",
     "unit": "s/mm",
     "source": {
      "lookup": "tblWeldAntiSpatterSpray.Spray Time Per Weld Length (s)"
     }
    },
    {
     "name": "Wire Mass",
     "unit": "kg",
     "formula": "pi / 4 * {Wire Diameter} * {Wire Diameter} * {Wire Feed Speed} * {Arc Time} * {Weld Density} / 1000000000"
    },
    {
     "name": "Wire Cost",
     "unit": "USD",
     "formula": "{Wire Mass} * {Wire Cost Per kg}"
    },
    {
     "name": "Gas Cost",
     "unit": "USD",
     "formula": "{Gas Cost Per Hour} * {Arc Time} / 3600"
    },
    {
     "name": "Tip and Nozzle Cost",
     "unit": "USD",
     "formula": "{Wire Mass} / max({Tip Life}, 0.001) * {Tip Cost} + {Wire Mass} / max({Nozzle Life}, 0.001) * {Nozzle Cost}"
    },
    {
     "name": "Spray Cost",
     "unit": "USD",
     "formula": "{Spray On} * {Weld Length} * {Spray Time Per Length} * {Spray Discharge} / max({Spray Volume} * {Spray Density}, 0.001) * {Spray Cost Per Can}"
    },
    {
     "name": "Consumables Cost",
     "unit": "USD",
     "formula": "{Wire Cost} + {Gas Cost} + {Tip and Nozzle Cost} + {Spray Cost}"
    }
   ]
  },
  {
   "key": "assembly.sealant_material",
   "name": "Assembly - Sealant and adhesive material",
   "helper": true,
   "operations": [],
   "output": "Material Mass",
   "results": [
    "Adhesive Mass",
    "Sealant Mass"
   ],
   "description": "The adhesive and sealant an assembly takes: the bonded area (defaultPercentBonded of the joint's area) under defaultResinThickness of resin at resinDensity with resinMaterialFactor for the loss in application; the sealant along the bead at sealantDensity. memory/Assembly gives no price for either: their mass is reported, not priced.",
   "fields": [
    {
     "name": "Bond Area",
     "unit": "mm²",
     "source": {
      "engine": "bond_area_mm2 (the adhesive joints' area)"
     }
    },
    {
     "name": "Percent Bonded",
     "unit": "%",
     "source": {
      "variable": "defaultPercentBonded"
     }
    },
    {
     "name": "Resin Thickness",
     "unit": "m",
     "source": {
      "variable": "defaultResinThickness"
     }
    },
    {
     "name": "Resin Density",
     "unit": "kg/m³",
     "source": {
      "variable": "resinDensity"
     }
    },
    {
     "name": "Resin Loss Factor",
     "unit": null,
     "source": {
      "variable": "resinMaterialFactor"
     }
    },
    {
     "name": "Sealant Volume",
     "unit": "mm³",
     "source": {
      "engine": "sealant_volume_mm3 (the sealing joints' bead or faying volume)"
     }
    },
    {
     "name": "Sealant Density",
     "unit": "kg/m³",
     "source": {
      "variable": "sealantDensity"
     }
    },
    {
     "name": "Adhesive Mass",
     "unit": "kg",
     "formula": "{Bond Area} * {Percent Bonded} / 100 * {Resin Thickness} * 1000 * {Resin Density} / 1000000000 * {Resin Loss Factor}"
    },
    {
     "name": "Sealant Mass",
     "unit": "kg",
     "formula": "{Sealant Volume} * {Sealant Density} / 1000000000"
    },
    {
     "name": "Material Mass",
     "unit": "kg",
     "formula": "{Adhesive Mass} + {Sealant Mass}"
    }
   ]
  },
  {
   "key": "assembly.pick_and_place",
   "name": "Assembly - Pick and place",
   "operations": [
    "Pick and Place"
   ],
   "description": "Loading a component into the assembly, per instance: its load time by its weight and largest dimension (componentLoadTimes: the first row that takes both, and the equipment it needs), times handlingMultiplier for the usual handling difficulties; the finished assembly is unloaded once (the same table, by the assembly's weight and size).",
   "fields": [
    {
     "name": "Quantity",
     "unit": null,
     "source": {
      "engine": "quantity (instances of the component in the assembly)"
     }
    },
    {
     "name": "Load Time",
     "unit": "s",
     "source": {
      "lookup": "componentLoadTimes.Load Time (s)"
     }
    },
    {
     "name": "Unload Time",
     "unit": "s",
     "source": {
      "engine": "unload_time_s (componentLoadTimes Unload Time for the whole assembly, on its own line; 0 on a component)"
     }
    },
    {
     "name": "Handling Multiplier",
     "unit": null,
     "source": {
      "variable": "handlingMultiplier"
     }
    },
    {
     "name": "Cycle Time Factor",
     "unit": null,
     "source": {
      "variable": "cycleTimeAdjustmentFactor"
     }
    },
    {
     "name": "Cycle Time",
     "unit": "s",
     "formula": "({Quantity} * {Load Time} + {Unload Time}) * {Handling Multiplier} * {Cycle Time Factor}"
    }
   ]
  },
  {
   "key": "assembly.mechanical",
   "name": "Assembly - Mechanical assembly",
   "operations": [
    "Mechanical Assembly"
   ],
   "description": "A mechanical fastening (a screw, a nut, a snap fit, ...), per joint: the Boothroyd-Dewhurst manual handling and insertion time of the operation (assembly_tblDfaOperationTimes, the eMithran DFA baseline), or the time the engineer set on the joint, times the joints.",
   "fields": [
    {
     "name": "Joints",
     "unit": null,
     "source": {
      "engine": "joint_count"
     }
    },
    {
     "name": "Operation Time",
     "unit": "s",
     "source": {
      "engine": "operation_time_s (assembly_tblDfaOperationTimes Total Time (s) for the operation, or the joint's own time)"
     }
    },
    {
     "name": "Cycle Time Factor",
     "unit": null,
     "source": {
      "variable": "cycleTimeAdjustmentFactor"
     }
    },
    {
     "name": "Cycle Time",
     "unit": "s",
     "formula": "{Joints} * {Operation Time} * {Cycle Time Factor}"
    }
   ]
  },
