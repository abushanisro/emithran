   "name": "Assembly - Robotic TIG welding",
   "operations": [
    "Robotic TIG Welding"
   ],
   "results": [
    "Arc Time",
    "Tack Time"
   ],
   "description": "Robotic TIG welding, per weld joint: the arc time over its length at the travel speed for its material, throat and gas, in the passes its throat takes (tblNumWeldPasses), times the machine's arc time standard; tacks every tack pitch; the gun placed for each weld and cleaned for its share of the arc (the machine's gun clean time per arc). A robot welds at efficiency 1, over its weld heads, and its programming per weld is spread over the batch.",
   "fields": [
    {
     "name": "Weld Length",
     "unit": "mm",
     "source": {
      "engine": "weld_length_mm (the joint's weld length)"
     }
    },
    {
     "name": "Welds",
