          }
        },
        {
          "name": "Bag Removal Rate",
          "unit": "mm/s",
          "source": {
            "variable": "vacuumBagRemovalRate"
          }
        },
        {
          "name": "Vacuum Port Time",
          "unit": "s",
          "source": {
            "variable": "installVacuumPortTime"
          }
        },
        {
          "name": "Bag Perimeter",
