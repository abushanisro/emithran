            "variable": "thermocoupleConnectionRate"
          }
        },
        {
          "name": "Drop Test Hold",
          "unit": "min",
          "source": {
            "variable": "vacuumDropTestHoldTime"
          }
        },
        {
          "name": "Thermocouples",
          "unit": null,
          "formula": "CEIL({Tool Side Area} / {Thermocouple Density})"
        },
        {
          "name": "Thermocouple Time",
          "unit": "s",
          "formula": "{Thermocouples} * ({Thermocouple Attach} + {Thermocouple Connect})"
        },
        {
          "name": "Drop Test Time",
          "unit": "s",
          "formula": "{Drop Test Hold} * 60"
        },
        {
          "name": "Cycle Time Factor",
          "unit": null,
          "source": {
            "variable": "cycleTimeAdjustmentFactor"
          }
        },
        {
          "name": "Debulks",
          "unit": null,
          "formula": "{Plies} >= {Plies Before First Debulk} ? 1 + floor(({Plies} - {Plies Before First Debulk}) / {Plies per Debulk}) : 0"
        },
        {
          "name": "Debulk Time",
          "unit": "s",
          "formula": "{Debulks} * ({Debulk Hold} * 60 + {Bag Perimeter} / {Bag Tape Rate} + {Vacuum Port Time} + {Bag Perimeter} / {Bag Removal Rate})"
        },
        {
          "name": "Cycle Time",
          "unit": "s",
          "formula": "({Ply Placement Time} + {Core Placement Time} + {Debulk Time} + {Thermocouple Time} + {Drop Test Time} + {Bag Perimeter} / {Bag Removal Rate}) * {Cycle Time Factor}"
        }
      ]
