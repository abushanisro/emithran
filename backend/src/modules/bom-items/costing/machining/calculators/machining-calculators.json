  "calculators": [
    {
      "name": "Machining - Drilling",
      "operation": "Drilling",
      "machineClasses": "lathes+mills",
      "description": "Drilled-hole cycle time: CAD hole diameter and depth, cutting speed and feed from tblDrilling for the material and drill construction.",
      "fields": [
        {
          "name": "Hole Diameter",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Hole Depth",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Holes",
          "unit": null,
          "source": "cad"
        },
        {
          "name": "Cutting Speed",
          "unit": "m/min",
          "source": "lookup",
          "table": "tblDrilling",
          "column": "cutting_speed_m_min"
        },
        {
          "name": "Feed",
          "unit": "mm/rev",
          "source": "lookup",
          "table": "tblDrilling",
          "column": "feed_mm_rev"
        },
        {
          "name": "Spindle Speed",
          "unit": "rpm",
          "formula": "{Cutting Speed} * 1000 / (pi * {Hole Diameter})"
        },
        {
          "name": "Feed Rate",
          "unit": "mm/min",
          "formula": "{Spindle Speed} * {Feed}"
        },
        {
          "name": "Time per Hole",
          "unit": "s",
          "formula": "{Hole Depth} / {Feed Rate} * 60"
        },
        {
          "name": "Cycle Time",
          "unit": "s",
          "formula": "{Time per Hole} * {Holes}"
        }
      ]
    },
    {
      "name": "Machining - Rough Turning",
      "operation": "Rough Turning",
      "machineClasses": "lathes",
      "description": "Rough turning passes over the turned length: CAD turned diameter/length, stock bar diameter, depth of cut / speed / feed from tblGeneralTurning.",
      "fields": [
        {
          "name": "Turned Diameter",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Turned Length",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Bar Diameter",
          "unit": "mm",
          "source": "engine"
        },
        {
          "name": "Finish Depth of Cut",
          "unit": "mm",
          "source": "lookup",
          "table": "tblGeneralTurning",
          "column": "cut_depth_mm"
        },
        {
          "name": "Rough Depth of Cut",
          "unit": "mm",
          "source": "lookup",
          "table": "tblGeneralTurning",
          "column": "cut_depth_mm"
        },
        {
          "name": "Rough Cutting Speed",
          "unit": "m/min",
          "source": "lookup",
          "table": "tblGeneralTurning",
          "column": "cutting_speed_m_min"
        },
        {
          "name": "Rough Feed",
          "unit": "mm/rev",
          "source": "lookup",
          "table": "tblGeneralTurning",
          "column": "feed_rate_mm_rev"
        },
        {
          "name": "Radial Stock",
          "unit": "mm",
          "formula": "({Bar Diameter} - {Turned Diameter}) / 2"
        },
        {
          "name": "Rough Stock",
          "unit": "mm",
          "formula": "max({Radial Stock} - min({Finish Depth of Cut}, {Radial Stock}), 0)"
        },
        {
          "name": "Rough Passes",
          "unit": null,
          "formula": "round({Rough Stock} / {Rough Depth of Cut})"
        },
        {
          "name": "Spindle Speed",
          "unit": "rpm",
          "formula": "{Rough Cutting Speed} * 1000 / (pi * {Turned Diameter})"
        },
        {
          "name": "Feed Rate",
          "unit": "mm/min",
          "formula": "{Spindle Speed} * {Rough Feed}"
        },
        {
          "name": "Time per Pass",
          "unit": "s",
          "formula": "{Turned Length} / {Feed Rate} * 60"
        },
        {
          "name": "Cycle Time",
          "unit": "s",
          "formula": "{Rough Passes} * {Time per Pass}"
        }
      ]
    },
    {
      "name": "Machining - Finish Turning",
