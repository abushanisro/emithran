    {
      "name": "Machining - Cylindrical Grinding",
      "operation": "Cylindrical Grinding",
      "machineClasses": [
        "cylindrical_grinder"
      ],
      "description": "Traverse grinding of a turned OD: CAD diameter/length, grinding allowance (variables finishGrindingDepth), wheel/work data from tblCylindricalGrinding.",
      "grinding": true,
      "fields": [
        {
          "name": "Grind Diameter",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Grind Length",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Surfaces",
          "unit": null,
          "source": "cad"
        },
        {
          "name": "Grinding Allowance",
          "unit": "mm",
          "source": "lookup",
          "table": "variables",
          "column": "value"
        },
        {
          "name": "Work Speed",
          "unit": "m/min",
          "source": "lookup",
          "table": "tblCylindricalGrinding",
          "column": "work_speed_m_min"
        },
        {
          "name": "Rough Infeed",
          "unit": "mm",
          "source": "lookup",
          "table": "tblCylindricalGrinding",
          "column": "rough_infeed_mm"
        },
        {
          "name": "Finish Infeed",
          "unit": "mm",
          "source": "lookup",
          "table": "tblCylindricalGrinding",
          "column": "finish_infeed_mm"
        },
        {
          "name": "Rough Axial Feed",
          "unit": "mm/rev",
          "source": "lookup",
          "table": "tblCylindricalGrinding",
          "column": "rough_axial_feed_rev_1"
        },
        {
          "name": "Finish Axial Feed",
          "unit": "mm/rev",
          "source": "lookup",
          "table": "tblCylindricalGrinding",
          "column": "finish_axial_feed_rev_1"
        },
        {
          "name": "Spindle Speed",
          "unit": "rpm",
          "formula": "{Work Speed} * 1000 / (pi * {Grind Diameter})"
        },
        {
          "name": "Finish Stock",
          "unit": "mm",
          "formula": "min({Finish Infeed}, {Grinding Allowance})"
        },
        {
          "name": "Rough Passes",
          "unit": null,
          "formula": "round(max({Grinding Allowance} - {Finish Stock}, 0) / {Rough Infeed})"
        },
        {
          "name": "Rough Pass Time",
          "unit": "s",
          "formula": "{Grind Length} / ({Spindle Speed} * {Rough Axial Feed}) * 60"
        },
        {
          "name": "Finish Pass Time",
          "unit": "s",
          "formula": "{Grind Length} / ({Spindle Speed} * {Finish Axial Feed}) * 60"
        },
        {
          "name": "Time per Surface",
          "unit": "s",
          "formula": "{Rough Passes} * {Rough Pass Time} + {Finish Pass Time}"
        },
        {
          "name": "Cycle Time",
          "unit": "s",
          "formula": "{Time per Surface} * {Surfaces}"
        }
      ]
    },
