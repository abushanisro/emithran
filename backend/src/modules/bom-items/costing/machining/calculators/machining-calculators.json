    {
      "name": "Machining - Rigid Tapping",
      "operation": "Tapping",
      "machineClasses": "lathes+mills",
      "description": "Rigid tapping of a threaded hole: CAD thread diameter, depth and pitch (the part, else the ISO 261 coarse pitch of its nominal size), cutting speed from tblTapping for the material and pitch. The tap feeds one pitch per revolution in and reverses out at the same feed.",
      "fields": [
        {
          "name": "Thread Diameter",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Thread Depth",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Threads",
          "unit": null,
          "source": "cad"
        },
        {
          "name": "Thread Pitch",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Cutting Speed",
          "unit": "m/min",
          "source": "lookup",
          "table": "tblTapping",
          "column": "CuttingSpeedMPerMin"
        },
        {
          "name": "Spindle Speed",
          "unit": "rpm",
          "formula": "{Cutting Speed} * 1000 / (pi * {Thread Diameter})"
        },
        {
          "name": "Feed Rate",
          "unit": "mm/min",
          "formula": "{Spindle Speed} * {Thread Pitch}"
        },
        {
          "name": "Time per Thread",
          "unit": "s",
          "formula": "2 * {Thread Depth} / {Feed Rate} * 60"
        },
        {
          "name": "Cycle Time",
          "unit": "s",
          "formula": "{Time per Thread} * {Threads}"
        }
      ]
    },
