          "table": "tblInternalGrinding",
          "column": "Rough Axial Feed (rev^-1)"
        },
        {
          "name": "Finish Axial Feed",
          "unit": "mm/rev",
          "source": "lookup",
          "table": "tblInternalGrinding",
          "column": "Finish Axial Feed (rev^-1)"
        },
        {
          "name": "Spindle Speed",
          "unit": "rpm",
          "formula": "{Work Speed} * 1000 / (pi * {Grind Diameter})"
        },
        {
          "name": "Finish Stock",
          "unit": "mm",
          "formula": "min({Finish Infeed}, {Grinding Allowance})"
        },
        {
          "name": "Rough Passes",
          "unit": null,
          "formula": "round(max({Grinding Allowance} - {Finish Stock}, 0) / {Rough Infeed})"
        },
        {
          "name": "Rough Pass Time",
          "unit": "s",
          "formula": "{Grind Length} / ({Spindle Speed} * {Rough Axial Feed}) * 60"
        },
        {
          "name": "Finish Pass Time",
          "unit": "s",
          "formula": "{Grind Length} / ({Spindle Speed} * {Finish Axial Feed}) * 60"
        },
        {
          "name": "Time per Surface",
          "unit": "s",
          "formula": "{Rough Passes} * {Rough Pass Time} + {Finish Pass Time}"
        },
        {
          "name": "Cycle Time",
          "unit": "s",
          "formula": "{Time per Surface} * {Repetitions} * {Surfaces}"
        }
      ]
    },
    {
      "name": "Machining - Surface Grinding",
      "operation": "Surface Grinding",
      "machineClasses": [
        "reciprocating_surface_grinder"
      ],
      "description": "Traverse surface grinding of a flat face on a reciprocating grinder: CAD face length and width, grinding allowance (variables finishGrindingDepth), table speed, down-feeds and crossfeed from tblReciprocatingSurfaceGrinding (crossfeed capped at its fraction of the tblGrinding wheel width). Each pass strokes the face length once per crossfeed step across its width.",
      "grinding": true,
      "fields": [
        {
          "name": "Grind Length",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Grind Width",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Faces",
          "unit": null,
          "source": "cad"
        },
        {
          "name": "Grinding Allowance",
          "unit": "mm",
          "source": "lookup",
          "table": "variables",
          "column": "value"
        },
        {
          "name": "Table Speed",
          "unit": "m/min",
          "source": "lookup",
          "table": "tblReciprocatingSurfaceGrinding",
          "column": "TableSpeedMPerMin"
        },
        {
          "name": "Rough Downfeed",
          "unit": "mm",
          "source": "lookup",
          "table": "tblReciprocatingSurfaceGrinding",
          "column": "RoughDownfeedMm"
        },
        {
          "name": "Finish Downfeed",
          "unit": "mm",
          "source": "lookup",
          "table": "tblReciprocatingSurfaceGrinding",
          "column": "FinishDownfeedMm"
        },
        {
          "name": "Crossfeed",
          "unit": "mm",
          "source": "lookup",
          "table": "tblReciprocatingSurfaceGrinding",
          "alsoTables": [
            "tblGrinding"
          ],
          "column": "AbsoluteCrossfeedMm"
        },
        {
          "name": "Finish Stock",
          "unit": "mm",
          "formula": "min({Finish Downfeed}, {Grinding Allowance})"
        },
        {
          "name": "Rough Passes",
          "unit": null,
          "formula": "round(max({Grinding Allowance} - {Finish Stock}, 0) / {Rough Downfeed})"
        },
        {
          "name": "Strokes per Pass",
          "unit": null,
          "formula": "CEIL({Grind Width} / {Crossfeed})"
        },
        {
          "name": "Stroke Time",
          "unit": "s",
          "formula": "{Grind Length} / ({Table Speed} * 1000 / 60)"
        },
        {
          "name": "Time per Face",
          "unit": "s",
          "formula": "({Rough Passes} + 1) * {Strokes per Pass} * {Stroke Time}"
        },
        {
          "name": "Cycle Time",
          "unit": "s",
          "formula": "{Time per Face} * {Faces}"
        }
      ]
    },
    {
      "name": "Machining - Keyway Broaching",
      "operation": "Keyway Broaching",
      "machineClasses": [
        "broach"
      ],
      "description": "Keyway broaching with the reference broach for the keyway width and length: a pull-type broach (single pass) when one fits, else a shim-type broach (one pass per shim plus the first). Each pass strokes the broach (teeth x pitch) plus the keyway length at the broach cutting speed; the broach is repositioned between passes (variables).",
      "fields": [
        {
          "name": "Keyway Length",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Keyway Width",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Keyways",
          "unit": null,
          "source": "cad"
        },
        {
          "name": "Broach Teeth",
          "unit": null,
          "source": "lookup",
          "table": "tblPullTypeKeywayBroach",
          "column": "Teeth",
          "alsoTables": [
            "tblShimTypeKeywayBroach"
          ]
        },
        {
          "name": "Broach Pitch",
          "unit": "mm",
          "source": "lookup",
          "table": "tblPullTypeKeywayBroach",
          "column": "Pitch (mm)",
          "alsoTables": [
            "tblShimTypeKeywayBroach"
          ]
        },
        {
          "name": "Cutting Speed",
          "unit": "m/min",
          "source": "lookup",
          "table": "tblPullTypeKeywayBroach",
          "column": "Cutting Speed (m / min)",
          "alsoTables": [
            "tblShimTypeKeywayBroach"
          ]
        },
        {
          "name": "Passes",
          "unit": null,
          "source": "lookup",
          "table": "tblPullTypeKeywayBroach",
          "column": "Passes",
          "alsoTables": [
            "tblShimTypeKeywayBroach"
          ]
        },
        {
          "name": "Positioning Time",
          "unit": "s",
          "source": "lookup",
          "table": "variables",
          "column": "value"
        },
        {
          "name": "Broach Length",
          "unit": "mm",
          "formula": "{Broach Teeth} * {Broach Pitch}"
        },
        {
          "name": "Stroke Time",
          "unit": "s",
          "formula": "({Broach Length} + {Keyway Length}) / ({Cutting Speed} * 1000 / 60)"
        },
        {
          "name": "Time per Keyway",
          "unit": "s",
          "formula": "{Passes} * {Stroke Time} + ({Passes} - 1) * {Positioning Time}"
        },
        {
          "name": "Cycle Time",
          "unit": "s",
          "formula": "{Time per Keyway} * {Keyways}"
        }
      ]
    },
    {
      "name": "Machining - Wire EDM",
      "operation": "Wire EDM",
      "machineClasses": [
        "wire_edm"
      ],
      "description": "One roughing and one finishing wire pass over the CAD cut path, feed rates from tblWireEDMing.",
      "fields": [
        {
          "name": "Cut Length",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Cuts",
          "unit": null,
          "source": "cad"
        },
        {
          "name": "Rough Feed Rate",
          "unit": "mm/min",
          "source": "lookup",
          "table": "tblWireEDMing",
          "column": "FeedRateMmPerMin"
        },
        {
          "name": "Finish Feed Rate",
          "unit": "mm/min",
          "source": "lookup",
          "table": "tblWireEDMing",
          "column": "FeedRateMmPerMin"
        },
        {
          "name": "Rough Pass Time",
          "unit": "s",
          "formula": "{Cut Length} / {Rough Feed Rate} * 60"
        },
        {
          "name": "Finish Pass Time",
          "unit": "s",
          "formula": "{Cut Length} / {Finish Feed Rate} * 60"
        },
        {
          "name": "Cycle Time",
          "unit": "s",
          "formula": "({Rough Pass Time} + {Finish Pass Time}) * {Cuts}"
        }
      ]
    },
    {
      "name": "Machining - Deburring",
      "operation": "Deburring",
      "machineClasses": [
        "manual_deburr"
      ],
      "description": "Deburring every sharp edge: CAD sharp-edge length (seams and tangent edges excluded) at the tblDeburring edge speed for the material.",
      "fields": [
        {
          "name": "Sharp Edge Length",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Edge Speed",
          "unit": "mm/s",
          "source": "lookup",
          "table": "tblDeburring",
          "column": "linear_speed_mm_s"
        },
        {
          "name": "Cycle Time",
          "unit": "s",
          "formula": "{Sharp Edge Length} / {Edge Speed}"
        }
      ]
    },
    {
      "name": "Machining - Index Transfer",
      "operation": "Index Transfer",
      "machineClasses": [
        "simultaneous_turning"
      ],
      "description": "Multi-spindle index cycle per part: drum index, transfer, stock feed and speed synchronisation times from the machine record.",
      "fields": [
        {
          "name": "Drum Index Time",
          "unit": "s",
          "source": "machine"
        },
        {
          "name": "Transfer Time",
          "unit": "s",
          "source": "machine"
        },
        {
          "name": "Stock Feed Time",
          "unit": "s",
          "source": "machine"
        },
        {
          "name": "Speed Synchronization Time",
          "unit": "s",
          "source": "machine"
        },
        {
          "name": "Cycle Time",
          "unit": "s",
          "formula": "{Drum Index Time} + {Transfer Time} + {Stock Feed Time} + {Speed Synchronization Time}"
        }
      ]
    },
    {
      "name": "Machining - Secondary Setup",
      "operation": "Secondary Setup (Rechuck)",
      "machineClasses": "lathes",
      "description": "A second chucking for features a 2-axis lathe cannot reach in one setup: workholder install-and-remove time from tblInstallingTurningWorkholders, spread over the batch.",
      "fields": [
        {
          "name": "Workholder Install and Remove Time",
          "unit": "min",
          "source": "lookup",
          "table": "tblInstallingTurningWorkholders",
          "column": "Install And Remove Time (min)"
        },
        {
          "name": "Batch Size",
          "unit": null,
          "source": "bom"
        },
        {
          "name": "Cycle Time",
          "unit": "s",
          "formula": "{Workholder Install and Remove Time} * 60 / {Batch Size}"
        }
      ]
    },
    {
      "name": "Machining - Inspection",
      "operation": "Inspection",
      "machineClasses": [
        "machining_inspection",
        "special_inspection"
      ],
      "description": "Inspection time per part: per-piece measurement (allowances are database defaults — no reference source maps features to tblInspection analyses), spread over first-article / in-process / final sampling.",
      "fields": [
        {
          "name": "Holes",
          "unit": null,
          "source": "cad"
        },
        {
          "name": "Threads",
          "unit": null,
          "source": "drawing"
        },
        {
          "name": "Tightest Tolerance",
          "unit": "mm",
          "source": "drawing"
        },
        {
          "name": "GDT Time",
          "unit": "min",
          "source": "engine"
        },
        {
          "name": "Batch Size",
          "unit": null,
          "source": "bom"
        },
        {
          "name": "First Article Pieces",
          "unit": null,
          "source": "engine"
        },
        {
          "name": "In-process 1 in N",
          "unit": null,
          "source": "engine"
        },
        {
          "name": "Final Check 1 in N",
          "unit": null,
          "source": "engine"
        },
        {
          "name": "Final Check Time",
          "unit": "min",
          "source": "engine"
        },
        {
          "name": "Positioning Time",
          "unit": "min",
          "source": "default",
          "default": 5
        },
        {
          "name": "Hole Sample Rate",
          "unit": null,
          "source": "default",
          "default": 5
        },
        {
          "name": "Max Holes Sampled",
          "unit": null,
          "source": "default",
          "default": 15
        },
        {
          "name": "Time per Sampled Hole",
          "unit": "min",
          "source": "default",
          "default": 0.5
        },
        {
          "name": "Max Threads Checked",
          "unit": null,
          "source": "default",
          "default": 6
        },
        {
          "name": "Time per Thread Gauge",
          "unit": "min",
          "source": "default",
          "default": 0.4
        },
        {
          "name": "Tight Tolerance Threshold",
          "unit": "mm",
          "source": "default",
          "default": 0.05
        },
        {
          "name": "Tight Tolerance CMM Time",
          "unit": "min",
          "source": "default",
          "default": 8
        },
        {
          "name": "Holes Sampled",
          "unit": null,
          "formula": "min(ceil({Holes} / {Hole Sample Rate}), {Max Holes Sampled})"
        },
        {
          "name": "Threads Checked",
          "unit": null,
          "formula": "min({Threads}, {Max Threads Checked})"
        },
        {
          "name": "Tight Tolerance Time",
          "unit": "min",
          "formula": "IF({Tightest Tolerance} > 0 and {Tightest Tolerance} <= {Tight Tolerance Threshold}, {Tight Tolerance CMM Time}, 0)"
        },
        {
          "name": "Inspection per Piece",
          "unit": "min",
          "formula": "{Positioning Time} + {Holes Sampled} * {Time per Sampled Hole} + {Threads Checked} * {Time per Thread Gauge} + {Tight Tolerance Time} + {GDT Time}"
        },
        {
          "name": "In-process Pieces",
          "unit": null,
          "formula": "floor(max({Batch Size} - {First Article Pieces}, 0) / {In-process 1 in N})"
        },
        {
          "name": "Final Check Pieces",
          "unit": null,
          "formula": "ceil({Batch Size} / {Final Check 1 in N})"
        },
        {
          "name": "Measured Minutes per Batch",
          "unit": "min",
          "formula": "{Inspection per Piece} * ({First Article Pieces} + {In-process Pieces}) + {Final Check Time} * {Final Check Pieces}"
        },
        {
          "name": "Cycle Time",
          "unit": "s",
          "formula": "{Measured Minutes per Batch} / {Batch Size} * 60"
        }
      ]
    },
    {
      "name": "Machining - Hobbing",
      "operation": "Hobbing",
      "machineClasses": [
        "hob_machine"
      ],
      "description": "Hobbing a gear: CAD teeth, face width, module (tip diameter / (teeth + 2)) and tooth depth ((tip - root) / 2); ANSI hob diameter and starts (tblAnsiHobbing, variables defaultNumStarts); cutting speed and axial feed (tblHobbing). The hob travels the face width plus its approach (the chord of a hob of that diameter entering the tooth depth); the gear turns teeth / starts revolutions per hob revolution.",
      "fields": [
        {
          "name": "Teeth",
          "unit": null,
          "source": "cad"
        },
        {
          "name": "Face Width",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Module",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Tooth Depth",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Hob Diameter",
          "unit": "mm",
          "source": "lookup",
          "table": "tblAnsiHobbing",
          "column": "hob_diameter_mm"
        },
        {
          "name": "Starts",
          "unit": null,
          "source": "lookup",
          "table": "variables",
          "column": "value"
        },
        {
          "name": "Cutting Speed",
          "unit": "m/min",
          "source": "lookup",
          "table": "tblHobbing",
          "column": "Cutting Speed (m / min)"
        },
        {
          "name": "Axial Feed",
          "unit": "mm/rev",
          "source": "lookup",
          "table": "tblHobbing",
          "column": "Feed (mm / rev)"
        },
        {
          "name": "Hob Speed",
          "unit": "rpm",
          "formula": "{Cutting Speed} * 1000 / (pi * {Hob Diameter})"
        },
        {
          "name": "Approach",
          "unit": "mm",
          "formula": "sqrt({Tooth Depth} * ({Hob Diameter} - {Tooth Depth}))"
        },
        {
          "name": "Axial Travel",
          "unit": "mm",
          "formula": "{Face Width} + {Approach}"
        },
        {
          "name": "Cycle Time",
          "unit": "s",
          "formula": "{Axial Travel} * {Teeth} / ({Hob Speed} * {Starts} * {Axial Feed}) * 60"
        }
      ]
    },
    {
      "name": "Machining - Shaving",
      "operation": "Shaving",
      "machineClasses": [
        "shaver"
      ],
      "description": "Gear shaving after hobbing: CAD teeth, module and face width; strokes, cutting speed and feed per workpiece revolution from tblShaving; workpiece speed capped at variables maxShavingWorkpieceSpeed. Each stroke traverses the face width.",
      "fields": [
        {
          "name": "Teeth",
          "unit": null,
          "source": "cad"
        },
        {
          "name": "Module",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Face Width",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Strokes",
          "unit": null,
          "source": "lookup",
          "table": "tblShaving",
          "column": "Strokes"
        },
        {
          "name": "Cutting Speed",
          "unit": "m/min",
          "source": "lookup",
          "table": "tblShaving",
          "column": "Cutting Speed (m / min)"
        },
        {
          "name": "Feed",
          "unit": "mm/rev",
          "source": "lookup",
          "table": "tblShaving",
          "column": "Feed Per Rev (mm / rev)"
        },
        {
          "name": "Max Workpiece Speed",
          "unit": "rpm",
          "source": "lookup",
          "table": "variables",
          "column": "value"
        },
        {
          "name": "Pitch Diameter",
          "unit": "mm",
          "formula": "{Module} * {Teeth}"
        },
        {
          "name": "Workpiece Speed",
          "unit": "rpm",
          "formula": "min({Cutting Speed} * 1000 / (pi * {Pitch Diameter}), {Max Workpiece Speed})"
        },
        {
          "name": "Stroke Time",
          "unit": "s",
          "formula": "{Face Width} / ({Feed} * {Workpiece Speed}) * 60"
        },
        {
          "name": "Cycle Time",
          "unit": "s",
          "formula": "{Strokes} * {Stroke Time}"
        }
      ]
    },
    {
      "name": "Machining - Rotary Broaching",
      "operation": "Rotary Broaching",
      "machineClasses": "lathes+mills",
      "description": "Rotary broaching a polygon socket (drawing polygon callout + CAD polygon ring): depth from CAD; RPM and feed from tblRotaryBroaching (depth within the broach reach), feed calibrated by variables rotaryBroachFeedAdjustment. The pilot hole is priced by the Drilling calculator.",
      "fields": [
        {
          "name": "Polygon Depth",
          "unit": "mm",
          "source": "cad"
        },
        {
          "name": "Polygons",
          "unit": null,
          "source": "cad"
        },
        {
          "name": "RPM",
          "unit": "rpm",
          "source": "lookup",
          "table": "tblRotaryBroaching",
          "column": "RPM"
        },
        {
          "name": "Feed",
          "unit": "mm/rev",
          "source": "lookup",
          "table": "tblRotaryBroaching",
          "column": "FeedMmPerRev"
        },
        {
          "name": "Feed Adjustment",
          "unit": null,
          "source": "lookup",
          "table": "variables",
          "column": "value"
        },
        {
          "name": "Time per Polygon",
          "unit": "s",
          "formula": "{Polygon Depth} / ({RPM} * {Feed} * {Feed Adjustment}) * 60"
        },
        {
          "name": "Cycle Time",
          "unit": "s",
          "formula": "{Time per Polygon} * {Polygons}"
        }
      ]
    }
