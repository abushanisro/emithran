{
  "name": "api-gateway",
  "version": "2.0.0",
  "description": "mithran API Gateway - Central entry point for all microservices - v2",
  "author": "mithran Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npx @nestjs/cli build",
    "build:release": "npx @nestjs/cli build -p tsconfig.release.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npx nest start",
    "start:dev": "npx nest start --watch",
    "start:debug": "npx nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typecheck": "tsc --noEmit",
    "check:rls": "node scripts/check-rls-bypass.js",
    "prebuild": "rimraf dist tsconfig.tsbuildinfo",
    "prestart:dev": "rimraf dist tsconfig.tsbuildinfo",
    "db:migrate": "ts-node -r tsconfig-paths/register scripts/migrate.ts",
    "should-cost:calibrate": "ts-node -r tsconfig-paths/register scripts/should-cost-calibrate.ts",
    "migrations:inventory": "ts-node -r tsconfig-paths/register scripts/migration-inventory.ts",
    "electronics:sync-contract": "node scripts/sync-electronics-contract.js",
    "cad:sync-contract": "node scripts/sync-cad-contract.js",
    "lint:electronics-boundary": "node scripts/lint-electronics-boundary.js",
    "check:electronics-memory": "node scripts/check-electronics-memory.js",
    "electronics:sync-lookups": "node scripts/sync-electronics-lookups.js",
    "test:sql": "bash test/sql/run.sh",
    "test:postgrest": "bash test/postgrest/run.sh",
    "test:s3": "bash test/storage/run.sh",
    "test:boot": "bash test/smoke/boot.sh",
    "test:baseline": "bash test/baseline/run.sh",
    "local:up": "bash scripts/local-data.sh up",
    "local:load": "bash scripts/local-data.sh load",
    "local:use": "bash scripts/local-data.sh use",
    "local:restore": "bash scripts/local-data.sh restore",
    "local:status": "bash scripts/local-data.sh status",
    "local:down": "bash scripts/local-data.sh down",
    "local:reset": "bash scripts/local-data.sh reset",
    "auth0:check": "ts-node -r tsconfig-paths/register scripts/auth0-check.ts",
    "test:local": "bash test/local-data/run.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@nestjs/axios": "^3.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^5.1.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.70.0",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "@supabase/postgrest-js": "^2.118.0",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.5",
    "ajv8": "npm:ajv@^8.17.1",
    "axios": "^1.6.5",
    "camel-case": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "form-data": "^4.0.5",
    "helmet": "^7.1.0",
    "jose": "^5.10.0",
    "mathjs": "^15.1.0",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "pdf2pic": "^3.2.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "snake-case": "^3.0.4",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.1.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.0.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.56.0",
    "jest": "^30.5.2",
    "jszip": "^3.10.2",
    "prettier": "^3.2.4",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "multer": "2.5.0",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "brace-expansion@>=4 <5.0.12": "5.0.12",
    "tsx": {
      "esbuild": "0.28.2"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.1"
    },
    "@nestjs/swagger": {
      "js-yaml": "^4.3.2"
    }
  }
}
